### 📊 代码行数追踪器

```typescript
class CodeLineTracker {
  private currentSessionLines: number = 0
  private lastCheckpoint: number = 0
  private filesCreated: string[] = []
  
  addCode(fileName: string, code: string) {
    const lines = code.split('\n').length
    this.currentSessionLines += lines
    this.filesCreated.push(`${fileName} (${lines}行)`)
    this.checkThreshold()
  }
  
  checkThreshold() {
    if (this.currentSessionLines >= 280 && this.currentSessionLines < 300) {
      console.warn("⚠️ 警告：已编写" + this.currentSessionLines + "行，接近300行限制")
    }
    
    if (this.currentSessionLines >= 300) {
      console.error("🚨 强制停止：已达到300行限制")
      console.error("🚨 必须：立即执行质量门禁检查")
      this.triggerQualityGate()
      return false
    }
    
    return true
  }
  
  reset() {
    this.lastCheckpoint = this.currentSessionLines
    this.currentSessionLines = 0
    this.filesCreated = []
  }
}
```

