```typescript
interface ExecutionContext {
  codeLines: number
  modifiedFiles: string[]
  hasPackagesChange: boolean
  hasBackendChange: boolean
  commitMessage?: string
}

function recommendMode(context: ExecutionContext): ExecutionMode {
  // 规则1: 后端修改 → STRICT
  if (context.hasBackendChange) {
    return 'STRICT'
  }
  
  // 规则2: packages修改 → STRICT
  if (context.hasPackagesChange) {
    return 'STRICT'
  }
  
  // 规则3: >200行代码 → STRICT
  if (context.codeLines > 200) {
    return 'STRICT'
  }
  
  // 规则4: 100-200行 → STANDARD
  if (context.codeLines >= 100) {
    return 'STANDARD'
  }
  
  // 规则5: 小修改 → FAST
  if (context.codeLines < 50 && context.modifiedFiles.length <= 3) {
    return 'FAST'
  }
  
  // 默认: STANDARD
  return 'STANDARD'
}
```

