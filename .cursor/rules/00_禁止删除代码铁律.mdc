## 📋 正确的代码处理范例
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

### ✅ 范例1：需要移除某个功能

**❌ 错误做法：直接删除**
```typescript
// 旧代码（被删除）
// function validateUser(user: User) {
//   if (!user.email) throw new Error('Email required')
//   return true
// }
```

**✅ 正确做法：先注释，再替代**
```typescript
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🔴 待删除代码（保留以备回滚）
// 删除原因: 改用新的验证框架
// 替代方案: 使用 ValidationService.validateUser()
// 标记日期: 2025-10-07
// 标记人: AI Assistant
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
/*
function validateUser(user: User) {
  if (!user.email) throw new Error('Email required')
  if (!user.password) throw new Error('Password required')
  return true
}
*/

// ✅ 新实现
function validateUserV2(user: User) {
  return ValidationService.validateUser(user)
}
```

### ✅ 范例2：需要重构代码

**❌ 错误做法：删除旧代码后写新代码**
```typescript
// 旧代码已被删除
// 新代码
function getUsers() {
  return users.filter(u => u.active)
}
```

**✅ 正确做法：保留旧代码注释**
```typescript
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 🟡 旧实现（已重构，保留以备参考）
// 重构原因: 性能优化
// 重构日期: 2025-10-07
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
/*
function getUsers() {
  const result = []
  for (let i = 0; i < users.length; i++) {
    if (users[i].active) {
      result.push(users[i])
    }
  }
  return result
}
*/

// ✅ 优化后的实现
function getUsers() {
  return users.filter(u => u.active)
}
```

### ✅ 范例3：需要修复类型错误

**❌ 错误做法：删除类型定义**
```typescript
// 类型定义被删除
function processData(data: any) {  // 使用 any 绕过
  return data.value
}
```

**✅ 正确做法：修正类型定义**
```typescript
// ✅ 保留并修正类型定义
interface DataType {
  value: string
  // 新增缺失的属性
  timestamp: number
}

function processData(data: DataType) {
  return data.value
}
```

