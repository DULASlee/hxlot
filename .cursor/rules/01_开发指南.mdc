## 📐 代码标准

### TypeScript/JavaScript标准

#### 命名规范

```typescript
// ✅ 正确
const userName = "张三"                    // camelCase - 变量
const MAX_RETRY_COUNT = 3                 // UPPER_SNAKE_CASE - 常量
class UserService { }                     // PascalCase - 类
interface UserDto { }                     // PascalCase - 接口
type UserId = string                      // PascalCase - 类型
function getUserById(id: string) { }      // camelCase - 函数
const isActive = true                     // is/has/can - 布尔值
const userList = []                       // 复数 - 数组

// ❌ 错误
const username = "张三"                    // 不清晰
const max_retry_count = 3                 // 常量应该大写
class userService { }                     // 类应该PascalCase
const active = true                       // 布尔值应该is/has/can
const user = []                           // 数组应该复数
```

#### 类型定义

```typescript
// ✅ 正确 - 100%类型安全
interface User {
  id: string
  name: string
  age: number
  email?: string                          // 可选属性
}

function getUser(id: string): Promise<User> {
  return api.get<User>(`/users/${id}`)
}

// Props定义
interface UserCardProps {
  user: User
  onEdit?: (user: User) => void
}

// ❌ 错误 - 使用any
function getUser(id: any): any {          // ❌ 严禁any
  return api.get(`/users/${id}`)
}

// ❌ 错误 - 缺少类型
function getUser(id) {                    // ❌ 缺少类型定义
  return api.get(`/users/${id}`)
}
```

#### 导入规范

```typescript
// ✅ 正确 - packages使用别名
import { Schema } from '@smartabp/lowcode-shared'
import { Designer } from '@smartabp/lowcode-core'

// ✅ 正确 - 主应用使用@/
import { UserService } from '@/services/UserService'
import type { User } from '@/types/user'

// ❌ 错误 - packages使用相对路径
import { Schema } from '../../../lowcode-shared'    // ❌ 违反架构

// ❌ 错误 - packages引用主应用
import { UserService } from '@/services/UserService' // ❌ 在packages中
```

