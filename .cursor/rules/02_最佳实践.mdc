## 🏗️ 架构最佳实践

### 组件设计

```typescript
// ✅ 正确 - 单一职责的组件
// UserCard.vue - 只负责展示用户卡片
interface UserCardProps {
  user: User
  editable?: boolean
}

// UserList.vue - 只负责用户列表
interface UserListProps {
  users: User[]
  loading?: boolean
}

// UserManagement.vue - 协调组件和数据
// 组合UserList和UserCard，处理数据加载和操作

// ❌ 错误 - 职责过多的组件
// UserComponent.vue - 既负责列表、又负责表单、还负责数据加载
// 这样的组件难以维护和测试
```

### 状态管理

```typescript
// ✅ 正确 - 清晰的Store设计
// stores/user.ts
export const useUserStore = defineStore('user', () => {
  // State
  const users = ref<User[]>([])
  const currentUser = ref<User | null>(null)
  const loading = ref(false)
  
  // Getters
  const activeUsers = computed(() => 
    users.value.filter(u => u.isActive)
  )
  
  // Actions
  async function fetchUsers() {
    loading.value = true
    try {
      users.value = await UserService.getList()
    } finally {
      loading.value = false
    }
  }
  
  async function updateUser(id: string, data: UpdateUserInput) {
    const user = await UserService.update(id, data)
    const index = users.value.findIndex(u => u.id === id)
    if (index >= 0) {
      users.value[index] = user
    }
  }
  
  return {
    users,
    currentUser,
    loading,
    activeUsers,
    fetchUsers,
    updateUser
  }
})
```

### API设计

```typescript
// ✅ 正确 - 统一的API Client
// services/user.service.ts
export class UserService {
  static async getList(params: GetUserListInput): Promise<PagedResultDto<UserDto>> {
    return http.get<PagedResultDto<UserDto>>('/api/users', { params })
  }
  
  static async get(id: string): Promise<UserDto> {
    return http.get<UserDto>(`/api/users/${id}`)
  }
  
  static async create(data: CreateUserInput): Promise<UserDto> {
    return http.post<UserDto>('/api/users', data)
  }
  
  static async update(id: string, data: UpdateUserInput): Promise<UserDto> {
    return http.put<UserDto>(`/api/users/${id}`, data)
  }
  
  static async delete(id: string): Promise<void> {
    return http.delete(`/api/users/${id}`)
  }
}

// ❌ 错误 - 零散的API调用
// 在组件中直接写fetch('/api/users')
// 没有类型定义、没有错误处理、难以维护
```

