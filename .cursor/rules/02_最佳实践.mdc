### 后端性能

#### API响应优化

```csharp
// ✅ 正确 - 使用分页避免大数据量
public async Task<PagedResultDto<UserDto>> GetListAsync(GetUserListInput input)
{
    var query = await _userRepository.GetQueryableAsync();
    
    // 只查询需要的字段
    var totalCount = await AsyncExecuter.CountAsync(query);
    var items = await AsyncExecuter.ToListAsync(
        query
            .Skip(input.SkipCount)
            .Take(input.MaxResultCount)  // 限制数量
    );
    
    return new PagedResultDto<UserDto>(totalCount, ObjectMapper.Map<List<User>, List<UserDto>>(items));
}

// ❌ 错误 - 查询所有数据
public async Task<List<UserDto>> GetAllAsync()
{
    var allUsers = await _userRepository.GetListAsync();  // 可能非常慢
    return ObjectMapper.Map<List<User>, List<UserDto>>(allUsers);
}
```

#### 数据库查询优化

```csharp
// ✅ 正确 - 使用Include避免N+1查询
var orders = await _orderRepository
    .Include(o => o.OrderItems)  // 预加载关联数据
    .Include(o => o.Customer)
    .ToListAsync();

// ❌ 错误 - N+1查询问题
var orders = await _orderRepository.GetListAsync();
foreach (var order in orders)
{
    var items = await _orderItemRepository.GetListAsync(o => o.OrderId == order.Id);  // N次查询
}
```

