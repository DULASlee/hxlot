## 🧠 阶段0: AI智能熟悉度评估(新增)

### 目标
**AI自动评估项目熟悉程度,选择最优执行路径**

### 执行步骤(30秒,自动)

```typescript
interface 智能熟悉度评估 {
  // AI自动执行,无需用户干预

  评估维度: {
    时间维度: {
      问题: "距离上次项目学习多久了?",
      评分规则: {
        "10分钟内": 100,
        "10-30分钟": 70,
        "30-60分钟": 40,
        "60分钟以上": 0
      },
      权重: 0.3
    },

    知识维度: {
      问题列表: [
        "能回答架构三大铁律吗?",
        "能列出完整技术栈吗?",
        "能说出主要模块和职责吗?"
      ],
      评分规则: {
        "3项全对": 100,
        "2项正确": 60,
        "1项正确": 30,
        "0项正确": 0
      },
      权重: 0.5
    },

    经验维度: {
      问题列表: [
        "最近做过类似功能吗?",
        "记得可用模板吗?"
      ],
      评分规则: {
        "都记得": 100,
        "部分记得": 50,
        "都不记得": 0
      },
      权重: 0.2
    }
  },

  综合评分: "时间×0.3 + 知识×0.5 + 经验×0.2",

  决策规则: {
    "85分以上": {
      模式: "跳过阶段1,直接进入阶段2",
      节约时间: "15分钟",
      适用: "非常熟悉项目的延续性开发"
    },

    "50-84分": {
      模式: "快速回顾5分钟 + 进入阶段2",
      节约时间: "10分钟",
      适用: "部分熟悉,需要简单温习"
    },

    "50分以下": {
      模式: "完整执行阶段1(8分钟) + 阶段2",
      节约时间: "0分钟",
      适用: "新项目或长时间未接触"
    }
  }
}
```

