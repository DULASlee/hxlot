      架构合规: "相对路径0违规 + @别名0违规 + 废弃包0引用"
    }
  },

  组3_代码学习检索: {
    时间: "3分钟",
    任务: [
      "search_codebase(类似功能关键词)",
      "glob_file_search('templates/**/*.template.*')",
      "list_dir('templates', recursive=true)",
      "find src/ -name '*.vue' | sed 's/.*\///' | sort | uniq -d"
    ],
    输出: {
      相似功能: ["已有功能列表", "可复用组件"],
      可用模板: ["CRUD模板", "Entity模板", "Store模板"],
      去重检查: "0重复组件 + 0重复函数"
    }
  }
}
```

