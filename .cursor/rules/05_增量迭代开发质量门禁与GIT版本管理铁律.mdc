    [ $PACKAGES_CROSS_REF -ne 0 ] && echo "   • packages存在跨层级引用: ${PACKAGES_CROSS_REF}个"
    [ $PACKAGES_MAIN_REF -ne 0 ] && echo "   • packages存在主应用引用: ${PACKAGES_MAIN_REF}个"
    echo "🚨 低代码生成器必须达到企业级100分标准！"
    exit 1
fi
```

