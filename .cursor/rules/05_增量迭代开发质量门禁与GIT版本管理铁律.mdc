PACKAGES_CROSS_REF=$(grep -r "import.*from '\.\./\.\./'"\src/SmartAbp.Vue/packages/ 2>/dev/null | wc -l)
PACKAGES_MAIN_REF=$(grep -r "import.*from '@/'" src/SmartAbp.Vue/packages/ 2>/dev/null | wc -l)

if [ $TS_BUILD_RESULT -eq 0 ] && [ $PACKAGES_LINT_RESULT -eq 0 ] && \
   [ $PACKAGES_CROSS_REF -eq 0 ] && [ $PACKAGES_MAIN_REF -eq 0 ]; then
