```typescript
if (检测到违规) {
  // 1. 立即停止
  console.error("🚨 设计系统违规检测！")
  停止所有操作()
  
  // 2. 报告违规
  console.error("违规类型：" + 违规类型)
  console.error("违规位置：" + 文件路径 + ":" + 行号)
  console.error("违规代码：" + 违规代码)
  
  // 3. 提供修复建议
  console.log("✅ 修复建议：" + 修复建议)
  
  // 4. 自动修复（如果可能）
  if (可以自动修复) {
    console.log("🔧 正在自动修复...")
    执行自动修复()
  }
  
  // 5. 重新检查
  console.log("🔍 重新执行检查...")
  重新执行四关门禁()
}
```

