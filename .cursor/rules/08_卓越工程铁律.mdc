💡 可读性示例：

// ❌ 不可读
function proc(d) {
  let r = [];
  for (let i = 0; i < d.length; i++) {
    if (d[i].s === 1 && d[i].a > 18 && d[i].c === 'US') {
      r.push(d[i]);
    }
  }
  return r;
}

// ✅ 可读
interface User {
  status: UserStatus;
  age: number;
  country: string;
}

enum UserStatus {
  Active = 1,
  Inactive = 0
}

const MINIMUM_AGE = 18;
const TARGET_COUNTRY = 'US';

function getActiveAdultUsersFromUS(users: User[]): User[] {
  return users.filter(user => 
    user.status === UserStatus.Active && 
    user.age > MINIMUM_AGE &&
    user.country === TARGET_COUNTRY
  );
}

// 或者更好：提取复杂条件
function isActiveAdultFromUS(user: User): boolean {
  return (
    user.status === UserStatus.Active &&
    user.age > MINIMUM_AGE &&
    user.country === TARGET_COUNTRY
  );
}

function getQualifiedUsers(users: User[]): User[] {
  return users.filter(isActiveAdultFromUS);
}
```

