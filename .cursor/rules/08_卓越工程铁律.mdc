### 📊 性能监控

**AI必须在关键位置添加性能监控：**

```typescript
// 前端性能监控类
class PerformanceMonitor {
  private static readonly SLOW_THRESHOLD = 100; // ms
  private static readonly VERY_SLOW_THRESHOLD = 1000; // ms
  
  static measure(name: string, fn: () => void): void {
    const start = performance.now();
    fn();
    const duration = performance.now() - start;
    this.report(name, duration);
  }
  
  static async measureAsync<T>(
    name: string, 
    fn: () => Promise<T>
  ): Promise<T> {
    const start = performance.now();
    try {
      const result = await fn();
      const duration = performance.now() - start;
      this.report(name, duration);
      return result;
    } catch (error) {
      const duration = performance.now() - start;
      this.report(name, duration, error);
      throw error;
    }
  }
  
  private static report(
    name: string, 
    duration: number, 
    error?: unknown
  ): void {
    const level = 
      duration > this.VERY_SLOW_THRESHOLD ? 'error' :
      duration > this.SLOW_THRESHOLD ? 'warn' : 
      'info';
    
    console[level](`[Performance] ${name}`, {
      duration: `${duration.toFixed(2)}ms`,
      status: error ? 'failed' : 'success',
      error: error instanceof Error ? error.message : undefined
    });
    
    // 发送到监控平台
    if (duration > this.SLOW_THRESHOLD) {
      sendToMonitoring({
        type: 'performance',
        name,
        duration,
        level,
        error
      });
    }
  }
}

// 使用
const users = await PerformanceMonitor.measureAsync(
  'fetchUsers',
  () => api.get('/users')
);
```

