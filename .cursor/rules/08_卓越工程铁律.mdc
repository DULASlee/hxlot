❌ 错误的错误处理：
  • 吞掉异常
  • 空catch块
  • 使用alert()
  • 抛出字符串

💡 错误处理最佳实践：
// Result类型定义
type Result<T, E = Error> = 
  | { ok: true; value: T }
  | { ok: false; error: E };

// ❌ 错误：吞掉异常
async function fetchData() {
  try {
    return await api.get('/data');
  } catch (error) {
    // 什么都不做 - 严重错误！
  }
}

// ✅ 正确：完整错误处理
async function fetchData(): Promise<Result<Data>> {
  try {
    const response = await api.get<Data>('/data');
    
    // 成功日志
    logger.info('Data fetched successfully', {
      url: '/data',
      timestamp: Date.now()
    });
    
    return { ok: true, value: response.data };
    
  } catch (error) {
    const err = error as Error;
    
    // 错误日志
    logger.error('Failed to fetch data', {
      error: err.message,
      stack: err.stack,
      url: '/data',
      timestamp: Date.now()
    });
    
    // 用户通知
    notifyUser({
      type: 'error',
      message: '无法加载数据，请稍后重试',
      action: '重试'
    });
    
    // 返回错误
    return { 
      ok: false, 
      error: new Error(`Failed to fetch data: ${err.message}`)
    };
  }
}

// 使用
const result = await fetchData();
if (result.ok) {
  processData(result.value);
} else {
  // 优雅降级
  showCachedData();
  // 或提供重试
  showRetryButton();
}
```

