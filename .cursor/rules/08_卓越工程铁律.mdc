interface HttpClient {
  get<T>(url: string): Promise<T>;
  post<T>(url: string, data: unknown): Promise<T>;
}

class UserService {
  constructor(private api: HttpClient) {} // 依赖注入
  
  async getUser(id: string): Promise<User> {
    return this.api.get<User>(`/users/${id}`);
  }
}

// 易于测试
