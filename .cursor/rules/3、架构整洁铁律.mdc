### 代码生成器基类约束
```csharp
// 所有生成器必须继承此基类
public abstract class BaseCodeGenerator
{
    // 必须实现：生成器唯一标识
    public abstract string GeneratorName { get; }

    // 必须实现：支持的实体类型
    public abstract Type[] SupportedEntityTypes { get; }

    // 必须实现：生成代码的主方法
    public abstract Task<GenerationResult> GenerateAsync(
        GenerationContext context,
        CancellationToken cancellationToken = default);

    // 必须实现：验证输入数据
    public abstract ValidationResult ValidateInput(object input);

    // 必须实现：获取生成的文件列表
    public abstract Task<FileInfo[]> GetGeneratedFilesAsync(string outputPath);
}
```

