## 场景3：在lowcode-designer中使用lowcode-core

```typescript
// 任务: 在设计器中添加代码预览功能

// ✅ 步骤1: 在lowcode-designer中正确引用lowcode-core
// src/SmartAbp.Vue/packages/lowcode-designer/src/components/CodePreview.vue

<script setup lang="ts">
// ✅ 正确：使用@smartabp别名
import { useCodeGenerationStore } from '@smartabp/lowcode-core'
import type { EntityMetadata } from '@smartabp/metadata-core'

interface Props {
  entity: EntityMetadata
  previewType: 'frontend' | 'backend'
}

const props = defineProps<Props>()
const codeGenStore = useCodeGenerationStore()

const previewCode = computed(() => {
  if (props.previewType === 'frontend') {
    return codeGenStore.previewFrontendCode(props.entity)
  } else {
    return codeGenStore.previewBackendCode(props.entity)
  }
})
</script>

<template>
  <div class="code-preview">
    <pre><code>{{ previewCode }}</code></pre>
  </div>
</template>
```

