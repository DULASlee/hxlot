// AI在生成任何页面代码前必须执行:
async function enforcePageCompleteness(pageCode: string): Promise<void> {
  const checks = [
    {
      name: '路由定义',
      check: () => checkRouteRegistration(pageCode),
      fix: '必须在src/router/modules/中定义路由'
    },
    {
      name: 'Layout使用',
      check: () => pageCode.includes('<MainLayout') || pageCode.includes('layout: MainLayout'),
      fix: '必须包裹在MainLayout组件中'
    },
    {
      name: '加载状态',
      check: () => pageCode.includes('loading') && pageCode.includes('v-loading'),
      fix: '必须添加v-loading加载状态'
    },
    {
      name: '错误处理',
      check: () => pageCode.includes('try') && pageCode.includes('catch'),
      fix: '必须添加try-catch错误处理'
    },
    {
      name: '空状态显示',
      check: () => pageCode.includes('empty') || pageCode.includes('v-if="data.length === 0"'),
      fix: '必须添加empty空状态显示'
    }
  ]
  
  const failures = checks.filter(c => !c.check())
  
  if (failures.length > 0) {
    console.error('❌ 页面完整性检查失败!')
    failures.forEach(f => {
      console.error(`  ❌ ${f.name}: ${f.fix}`)
    })
    throw new Error('禁止生成不完整的页面代码!')
  }
}
```

