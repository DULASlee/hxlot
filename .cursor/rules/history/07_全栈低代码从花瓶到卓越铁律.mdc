// AI在生成任何后端代码前必须执行:
public static void EnforceBackendPersistence(string serviceCode, string filePath)
{
    var errors = new List<string>();
    
    // 检查1: 必须注入Repository
    if (!serviceCode.Contains("IRepository<") && !serviceCode.Contains("Repository"))
    {
        errors.Add($"❌ {filePath} 未注入Repository!");
    }
    
    // 检查2: GetListAsync禁止返回假数据
    if (serviceCode.Contains("GetListAsync") && serviceCode.Contains("new List<"))
    {
        if (!serviceCode.Contains("_repository.GetListAsync") && 
            !serviceCode.Contains("_repository.GetQueryableAsync"))
        {
            errors.Add($"❌ {filePath} GetListAsync使用假数据!必须调用Repository");
        }
    }
    
    // 检查3: CreateAsync必须落库
    if (serviceCode.Contains("CreateAsync") || serviceCode.Contains("InsertAsync"))
    {
        if (!serviceCode.Contains("_repository.InsertAsync"))
        {
            errors.Add($"❌ {filePath} CreateAsync未落库!必须调用InsertAsync");
        }
    }
    
    // 检查4: UpdateAsync必须落库
    if (serviceCode.Contains("UpdateAsync"))
    {
        if (!serviceCode.Contains("_repository.UpdateAsync"))
        {
            errors.Add($"❌ {filePath} UpdateAsync未落库!必须调用UpdateAsync");
        }
    }
    
    // 检查5: DeleteAsync必须落库
    if (serviceCode.Contains("DeleteAsync"))
    {
        if (!serviceCode.Contains("_repository.DeleteAsync"))
        {
            errors.Add($"❌ {filePath} DeleteAsync未落库!必须调用DeleteAsync");
        }
    }
    
    if (errors.Count > 0)
    {
        foreach (var error in errors)
        {
            Console.Error.WriteLine(error);
        }
        throw new Exception("禁止生成不落库的后端代码!");
    }
}
```

