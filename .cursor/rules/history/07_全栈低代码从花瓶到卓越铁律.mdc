```typescript
// AI在生成任何代码前必须执行:
async function enforceCodeReuse(fileName: string, code: string): Promise<void> {
  const errors: string[] = []
  
  // 检查1: 重复组件
  if (fileName.endsWith('.vue')) {
    const existingFiles = await glob(`src/**/${path.basename(fileName)}`)
    if (existingFiles.length > 0) {
      errors.push(`❌ 组件重复: ${fileName} 已存在于 ${existingFiles.join(', ')}`)
    }
  }
  
  // 检查2: CRUD未使用模板
  const isCrudFile = /(List|Form|Detail)\.vue$/.test(fileName)
  if (isCrudFile && !code.includes('// @generated') && !code.includes('// @template')) {
    errors.push(`❌ CRUD页面必须使用模板生成: ${fileName}`)
  }
  
  // 检查3: 重复函数
  const functionNames = extractFunctionNames(code)
  for (const funcName of functionNames) {
    const existingFuncs = await searchFunction(funcName)
    if (existingFuncs.length > 0) {
      errors.push(`❌ 函数重复: ${funcName} 已存在于 ${existingFuncs.join(', ')}`)
    }
  }
  
  if (errors.length > 0) {
    console.error('❌ 代码复用检查失败!')
    errors.forEach(e => console.error(`  ${e}`))
    throw new Error('禁止创建重复代码!')
  }
}
```

