**AI强制执行检查**:

```typescript
// AI在生成任何API代码前必须执行:
function enforceAPIImplementation(apiCode: string, filePath: string): void {
  const errors: string[] = []
  
  // 检查1: 禁止假API
  if (apiCode.includes('Promise.resolve({') && !apiCode.includes('// @mock')) {
    errors.push(`❌ ${filePath} 使用假数据!禁止Promise.resolve,必须调用http`)
  }
  
  // 检查2: 必须有http调用
  const hasHttpCall = /http\.(get|post|put|delete|patch)/.test(apiCode)
  if (apiCode.includes('export const') && !hasHttpCall && !apiCode.includes('// @mock')) {
    errors.push(`❌ ${filePath} API未实现!必须调用http`)
  }
  
  // 检查3: 必须有类型定义
  if (apiCode.includes('export const') && !apiCode.includes(': Promise<')) {
    errors.push(`❌ ${filePath} 缺少返回类型定义!`)
  }
  
  // 检查4: 必须有错误处理
  if (hasHttpCall && !apiCode.includes('try') && !apiCode.includes('.catch(')) {
    errors.push(`❌ ${filePath} 缺少错误处理!必须有try-catch或.catch()`)
  }
  
  if (errors.length > 0) {
    console.error('❌ API实现检查失败!')
    errors.forEach(e => console.error(`  ${e}`))
    throw new Error('禁止生成假API或不完整的API!')
  }
}
```

