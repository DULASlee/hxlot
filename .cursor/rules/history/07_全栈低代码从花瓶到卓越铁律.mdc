// AI在生成任何控件代码前必须执行:
function enforceComponentCompleteness(componentCode: string): void {
  const errors: string[] = []
  
  // 检查1: 下拉选择必须绑定change事件
  if (componentCode.includes('<el-select') && !componentCode.includes('@change')) {
    errors.push('❌ el-select缺少@change事件绑定!')
  }
  
  // 检查2: 禁止硬编码数据
  const hasHardcodedOptions = /<el-option\s+label="[^"]+"\s+value="[^"]+"\s*\/>/.test(componentCode)
  if (hasHardcodedOptions && !componentCode.includes(':options=')) {
    errors.push('❌ el-select使用硬编码数据!必须从API获取')
  }
  
  // 检查3: v-model必须绑定
  if (componentCode.includes('<el-input') && !componentCode.includes('v-model')) {
    errors.push('❌ el-input缺少v-model绑定!')
  }
  
  // 检查4: 表单必须有验证规则
  if (componentCode.includes('<el-form') && !componentCode.includes(':rules=')) {
    errors.push('❌ el-form缺少验证规则!')
  }
  
  if (errors.length > 0) {
    console.error('❌ 控件完整性检查失败!')
    errors.forEach(e => console.error(`  ${e}`))
    throw new Error('禁止生成不完整的控件代码!')
  }
}
```

