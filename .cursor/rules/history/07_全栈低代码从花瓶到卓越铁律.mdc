// AI在生成任何低代码相关代码前,必须执行此流程:
async function enforceExcellenceIronLaw(
  codeType: 'page' | 'component' | 'frontend-api' | 'backend-service' | 'dto',
  fileName: string,
  code: string
): Promise<void> {
  
  console.log('🛡️ 执行从花瓶到卓越铁律检查...')
  
  try {
    switch (codeType) {
      case 'page':
        await enforcePageCompleteness(code)
        await enforceCodeReuse(fileName, code)
        break
        
      case 'component':
        enforceComponentCompleteness(code)
        await enforceCodeReuse(fileName, code)
        break
        
      case 'frontend-api':
        enforceAPIImplementation(code, fileName)
        await enforceCodeReuse(fileName, code)
        break
        
      case 'backend-service':
        EnforceBackendPersistence(code, fileName)
        await enforceCodeReuse(fileName, code)
        break
        
      case 'dto':
        const entityName = extractEntityName(fileName)
        await enforceDTOConsistency(entityName)
        break
    }
    
    console.log('✅ 从花瓶到卓越铁律检查通过!')
    
  } catch (error: any) {
    console.error('❌ 从花瓶到卓越铁律检查失败!')
    console.error(error.message)
    throw new Error('禁止生成不符合卓越标准的代码!')
