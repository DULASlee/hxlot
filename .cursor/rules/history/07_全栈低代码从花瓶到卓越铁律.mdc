// AI在生成任何DTO代码前必须执行:
async function enforceDTOConsistency(entityName: string): Promise<void> {
  const errors: string[] = []
  
  // 1. 检查Schema是否存在
  const schemaPath = `src/schemas/${entityName}.json`
  if (!await fs.pathExists(schemaPath)) {
    errors.push(`❌ Schema缺失: ${schemaPath}, 必须先定义UnifiedSchema!`)
  }
  
  // 2. 检查前端DTO
  const frontendDtoPath = `src/types/${entityName}Dto.ts`
  if (!await fs.pathExists(frontendDtoPath)) {
    errors.push(`❌ 前端DTO缺失: ${frontendDtoPath}, 必须从Schema生成!`)
  }
  
  // 3. 检查后端DTO
  const backendDtoPath = `src/SmartAbp.Application.Contracts/${entityName}/${entityName}Dto.cs`
  if (!await fs.pathExists(backendDtoPath)) {
    errors.push(`❌ 后端DTO缺失: ${backendDtoPath}, 必须从Schema生成!`)
  }
  
  // 4. 检查AutoMapper
  const mapperPath = `src/SmartAbp.Application/${entityName}/${entityName}AutoMapperProfile.cs`
  if (!await fs.pathExists(mapperPath)) {
    errors.push(`❌ AutoMapper配置缺失: ${mapperPath}, 必须配置DTO映射!`)
  }
  
  if (errors.length > 0) {
    console.error('❌ DTO一致性检查失败!')
    errors.forEach(e => console.error(`  ${e}`))
    throw new Error('禁止生成不一致的DTO!')
  }
}
```

