### 代码生成器基类约束
```csharp
// 所有生成器必须继承此基类
public abstract class BaseCodeGenerator
{
    // 必须实现：生成器唯一标识
    public abstract string GeneratorName { get; }

    // 必须实现：支持的实体类型
    public abstract Type[] SupportedEntityTypes { get; }

    // 必须实现：生成代码的主方法
    public abstract Task<GenerationResult> GenerateAsync(
        GenerationContext context,
        CancellationToken cancellationToken = default);

    // 必须实现：验证输入数据
    public abstract ValidationResult ValidateInput(object input);

    // 必须实现：获取生成的文件列表
    public abstract Task<FileInfo[]> GetGeneratedFilesAsync(string outputPath);
}
```

### 服务接口强制规范
```csharp
// CodeGenerationAppService必须实现的接口
public interface ICodeGenerationAppService : IApplicationService
{
    // 必须：生成完整模块代码
    Task<CodeGenerationResultDto> GenerateFullStackCodeAsync(
        ModuleDefinitionDto input);

    // 必须：验证模块定义
    Task<ValidationResultDto> ValidateModuleDefinitionAsync(
        ModuleDefinitionDto input);

    // 必须：生成UI配置
    Task<UIConfigDto> GenerateUIConfigAsync(EntityDefinitionDto input);

    // 必须：获取代码生成进度
    Task<ProgressDto> GetGenerationProgressAsync(string taskId);

    // 禁止：任何AI相关的方法
    // 禁止：任何协作相关的方法
}
```

