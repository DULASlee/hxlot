{
  // ===== SmartAbp Cursor IDE 优化配置 - 解决终端卡死问题 =====

  // ===== 终端配置优化 =====
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.allowMnemonics": false,
  "terminal.integrated.windowsEnableConpty": true,
  "terminal.integrated.useWslProfiles": false,
  "terminal.integrated.enableBell": false,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "Consolas, 'Courier New', monospace",
  "terminal.integrated.scrollback": 1000,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.enableFileLinks": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.showWelcome": false,
  "terminal.integrated.defaultLocation": "panel",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.confirmOnExit": false,
  "terminal.integrated.confirmOnKill": false,
  "terminal.integrated.showExitAlert": false,

  // ===== 终端配置文件 - 支持PowerShell和Git Bash =====
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": ["-NoLogo", "-ExecutionPolicy", "Bypass"],
      "icon": "terminal-powershell",
      "overrideName": true
    },
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login"],
      "icon": "terminal-bash",
      "overrideName": true
    },
    "Command Prompt": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "args": [],
      "icon": "terminal-cmd",
      "overrideName": true
    }
  },

  // PowerShell 为默认终端（SmartAbp项目需要PowerShell脚本）
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // PowerShell 配置优化
  "powershell.enableProfileLoading": true,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.promptToUpdatePowerShell": false,
  "powershell.integratedConsole.suppressStartupBanner": true,

  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.inheritEnv": true,

  // ===== 系统性能优化 =====
  "workbench.editor.enablePreview": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.startupEditor": "none",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.editor.closeEmptyGroups": true,
  "workbench.editor.focusRecentEditorAfterClose": true,

  // ===== 文件系统优化 =====
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.next/**": true,
    "**/coverage/**": true,
    "**/.angular/**": true,
    "**/bower_components/**": true,
    "**/.sass-cache/**": true,
    "**/.idea/**": true,
    "**/.vscode/**": true,
    "**/tmp/**": true,
    "**/temp/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.DS_Store/**": true,
    "**/Thumbs.db/**": true,
    "**/*.log/**": true,
    "**/*.tmp/**": true
  },

  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/bin": true,
    "**/obj": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/bin": true,
    "**/obj": true,
    "**/.git": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.angular": true,
    "**/bower_components": true,
    "**/.sass-cache": true,
    "**/.idea": true,
    "**/.vscode": true,
    "**/tmp": true,
    "**/temp": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/Thumbs.db": true
  },

  "files.maxMemoryForLargeFilesMB": 512,
  "files.watcherPollInterval": 5000,
  "files.hotExit": "off",
  "files.restoreUndoStack": false,
  "files.saveConflictResolution": "overwriteFileContents",

  // ===== 编辑器性能优化（保留重要功能） =====
  "editor.largeFileOptimizations": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.smoothScrolling": false,
  "editor.cursorBlinking": "blink",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.linkedEditing": true,
  "editor.suggest.maxVisibleSuggestions": 12,
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.parameterHints.enabled": true,
  "editor.codeLens": true,
  "editor.folding": true,
  "editor.glyphMargin": true,
  "editor.scrollBeyondLastLine": false,
  "editor.stickyScroll.enabled": false,

  // ===== Git优化 =====
  "git.enabled": true,
  "git.autofetch": false,
  "git.confirmSync": false,
  "git.autorefresh": true,
  "git.showProgress": true,
  "git.countBadge": "tracked",
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "none",

  // ===== 扩展优化 =====
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "extensions.showRecommendationsOnlyOnDemand": true,
  "extensions.ignoreRecommendations": false,

  // ===== 隐私和遥测 =====
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "update.enableWindowsBackgroundUpdates": false,

  // ===== Windows 11 系统优化 =====
  "window.titleBarStyle": "native",
  "window.dialogStyle": "native",
  "window.nativeTabs": false,
  "window.openFoldersInNewWindow": "off",
  "window.restoreWindows": "folders",
  "window.zoomLevel": 0,
  "window.enableMenuBarMnemonics": false,
  "security.workspace.trust.enabled": true,
  "security.promptForLocalFileProtocolHandling": false,

  // ===== 语言特定设置 =====
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  "[powershell]": {
    "editor.wordWrap": "off",
    "editor.formatOnSave": false
  },
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  }
}
