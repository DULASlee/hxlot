{
  // ===== SmartAbp Cursor IDE 优化配置 - 解决终端卡死问题 =====

  // ===== 终端配置优化 - 彻底解决卡死问题 =====
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.allowMnemonics": false,
  "terminal.integrated.windowsEnableConpty": false,
  "terminal.integrated.useWslProfiles": false,
  "terminal.integrated.automationProfile.windows": null,
  "terminal.integrated.enableBell": false,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.fontFamily": "Consolas",
  "terminal.integrated.scrollback": 500,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.enableFileLinks": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.shellIntegration.showWelcome": false,
  "terminal.integrated.defaultLocation": "panel",
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.confirmOnExit": false,
  "terminal.integrated.confirmOnKill": false,
  "terminal.integrated.showExitAlert": false,

  // 默认使用SmartAbp统一PowerShell配置
  "terminal.integrated.defaultProfile.windows": "PowerShell (SmartAbp)",

  // 环境变量优化 - 基于统一环境配置
  "terminal.integrated.env.windows": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "LESSCHARSET": "utf-8",
    "MSYS_NO_PATHCONV": "1",
    "MSYS2_ARG_CONV_EXCL": "*",
    "TERM": "xterm-256color",
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "MANPAGER": "cat",
    "LESS": "",
    "SYSTEMD_PAGER": ""
  },

  // ===== SmartAbp 企业级统一终端配置文件 =====
  "terminal.integrated.profiles.windows": {
    "PowerShell (SmartAbp)": {
      "path": "pwsh.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-NoExit",
        "-File", "${workspaceFolder}\\.cursor\\unified-terminal.ps1"
      ],
      "icon": "terminal-powershell",
      "overrideName": false,
      "env": {
        "TERM": "xterm-256color",
        "PAGER": "cat",
        "GIT_PAGER": "cat"
      }
    },
    "Bash (SmartAbp)": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i", "-c", "source ${workspaceFolder}/.cursor/unified-terminal.sh; exec bash"],
      "icon": "terminal-bash",
      "overrideName": false,
      "env": {
        "TERM": "xterm-256color",
        "PAGER": "cat",
        "GIT_PAGER": "cat",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
      }
    },
    "CMD (SmartAbp)": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "args": ["/K", "chcp 65001 >nul && call \"${workspaceFolder}\\.cursor\\unified-terminal.bat\""],
      "icon": "terminal-cmd",
      "overrideName": false,
      "env": {
        "TERM": "xterm-256color"
      }
    }
  },


  // PowerShell 配置优化 - 完全禁用避免卡死
  "powershell.enableProfileLoading": false,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.promptToUpdatePowerShell": false,
  "powershell.integratedConsole.suppressStartupBanner": true,
  "powershell.powerShellDefaultVersion": "",
  "powershell.buttons.showPanelMovementButtons": false,
  "powershell.buttons.showRunButtons": false,

  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.inheritEnv": false,

  // 终端性能和稳定性优化 - 激进禁用模式
  "terminal.integrated.localEchoEnabled": "off",
  "terminal.integrated.localEchoLatencyThreshold": 30,
  "terminal.integrated.localEchoExcludePrograms": ["vim", "vi", "nano", "git", "less", "more"],
  "terminal.integrated.autoReplies": {
    "Terminate batch job (Y/N)?": "Y",
    "Press any key to continue...": " "
  },

  // 彻底禁用可能导致卡死的功能
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.experimentalUseTitleEvent": false,
  "terminal.integrated.fastScrollSensitivity": 1,
  "terminal.integrated.mouseWheelScrollSensitivity": 1,
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.rightClickBehavior": "default",
  "terminal.integrated.wordSeparators": " ()[]{}',\"`─''",

  // ===== 系统性能优化 =====
  "workbench.editor.enablePreview": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.startupEditor": "none",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.editor.closeEmptyGroups": true,


  // ===== TypeScript 语言服务优化 - 解决内存不足问题 =====
  "typescript.preferences.maxFileSize": 20971520,
  "typescript.disableAutomaticTypeAcquisition": false,
  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.tsserver.watchOptions": {
    "watchFile": "priorityPollingInterval",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": ["**/node_modules", "**/dist", "**/coverage", "**/reports", "**/.generated"]
  },
  "typescript.tsserver.enableTracing": false,
  "typescript.tsserver.log": "off",
  "typescript.preferences.disableSuggestions": false,
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "workbench.editor.focusRecentEditorAfterClose": true,

  // ===== 文件系统优化 =====
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.next/**": true,
    "**/coverage/**": true,
    "**/.angular/**": true,
    "**/bower_components/**": true,
    "**/.sass-cache/**": true,
    "**/.idea/**": true,
    "**/.vscode/**": true,
    "**/tmp/**": true,
    "**/temp/**": true,
    "**/.generated/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.DS_Store/**": true,
    "**/Thumbs.db/**": true,
    "**/*.log/**": true,
    "**/*.tmp/**": true
  },

  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/bin": true,
    "**/obj": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/bin": true,
    "**/obj": true,
    "**/.git": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.generated": true,
    "**/.angular": true,
    "**/bower_components": true,
    "**/.sass-cache": true,
    "**/.idea": true,
    "**/.vscode": true,
    "**/tmp": true,
    "**/temp": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/Thumbs.db": true
  },

  "files.maxMemoryForLargeFilesMB": 512,
  "files.watcherPollInterval": 5000,
  "files.hotExit": "off",
  "files.restoreUndoStack": false,
  "files.saveConflictResolution": "overwriteFileContents",

  // ===== 编辑器性能优化（保留重要功能） =====
  "editor.largeFileOptimizations": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.smoothScrolling": false,
  "editor.cursorBlinking": "blink",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.linkedEditing": true,
  "editor.suggest.maxVisibleSuggestions": 12,
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.parameterHints.enabled": true,
  "editor.codeLens": true,
  "editor.folding": true,
  "editor.glyphMargin": true,
  "editor.scrollBeyondLastLine": false,
  "editor.stickyScroll.enabled": false,

  // ===== Git优化 - 彻底解决卡死问题 =====
  "git.enabled": true,
  "git.autofetch": false,
  "git.confirmSync": false,
  "git.autorefresh": false,
  "git.showProgress": false,
  "git.countBadge": "off",
  "git.enableSmartCommit": false,
  "git.postCommitCommand": "none",
  "git.path": "C:\\Program Files\\Git\\bin\\git.exe",
  "git.terminalAuthentication": false,
  "git.useIntegratedAskpass": false,
  "git.decorations.enabled": false,
  "git.timeline.enabled": false,
  "git.allowForcePush": true,
  "git.alwaysSignOff": false,
  "git.autoRepositoryDetection": false,
  "git.branchProtection": [],

  // ===== 彻底禁用可能导致卡死的功能 =====
  "workbench.activityBar.visible": true,
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.opensMaximized": "never",
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,

  // ===== 扩展优化 =====
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "extensions.showRecommendationsOnlyOnDemand": true,
  "extensions.ignoreRecommendations": false,

  // ===== 隐私和遥测 =====
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "update.enableWindowsBackgroundUpdates": false,

  // ===== Windows 11 系统优化 =====
  "window.titleBarStyle": "native",
  "window.dialogStyle": "native",
  "window.nativeTabs": false,
  "window.openFoldersInNewWindow": "off",
  "window.restoreWindows": "folders",
  "window.zoomLevel": 0,
  "window.enableMenuBarMnemonics": false,
  "security.workspace.trust.enabled": true,
  "security.promptForLocalFileProtocolHandling": false,

  // ===== MCP (Model Context Protocol) 配置 =====
  "mcp.servers": {
    "serena": {
      "command": "node",
      "args": [
        "${workspaceFolder}/.serena/mcp-server.js"
      ],
      "env": {
        "SERENA_PROJECT_ROOT": "${workspaceFolder}",
        "SERENA_CONFIG_PATH": "${workspaceFolder}/.serena/project.yml",
        "SERENA_CACHE_DIR": "${workspaceFolder}/.serena",
        "NODE_ENV": "production"
      }
    }
  },

  // ===== 语言特定设置 =====
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  "[powershell]": {
    "editor.wordWrap": "off",
    "editor.formatOnSave": false
  },
  "[csharp]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  }
}
