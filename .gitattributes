# ========================================
# SmartAbp 企业级 Git Attributes 配置
# ========================================

# 🔧 默认文本文件设置
* text=auto eol=lf

# 📄 源代码文件强制LF换行
*.cs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# 🔧 配置文件
*.config.* text eol=lf
*.conf text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 📜 Shell脚本和批处理
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 🔒 二进制文件明确标记
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.7z binary
*.rar binary

# 🔧 字体文件
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# 📦 Office文档
*.docx binary
*.xlsx binary
*.pptx binary

# 🎯 .NET二进制文件
*.dll binary
*.exe binary
*.pdb binary

# 🔍 语言统计设置
**/wwwroot/libs/** linguist-vendored
**/node_modules/** linguist-vendored
**/dist/** linguist-generated
**/build/** linguist-generated
**/*.min.js linguist-generated
**/*.min.css linguist-generated

# 📊 指定主要语言
*.cs linguist-language=C#
*.vue linguist-language=Vue
*.ts linguist-language=TypeScript

# 🎨 模板文件特殊处理
templates/**/*.template.* text eol=lf
**/*.template text eol=lf

# 🔧 低代码引擎特定文件
packages/lowcode-*/**/*.ts text eol=lf
packages/lowcode-*/**/*.vue text eol=lf

# 📝 文档文件
*.md text eol=lf diff=markdown

# 🔄 合并策略
*.sln merge=union
*.csproj merge=union
package.json merge=union
package-lock.json binary
