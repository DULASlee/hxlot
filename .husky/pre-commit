echo "🎨 第一关：设计系统合规性检查..."

# Windows环境使用PowerShell脚本
if [ -f "scripts/quality/design-system-check.ps1" ]; then
  pwsh -File scripts/quality/design-system-check.ps1 -NonInteractive
  DESIGN_CHECK_RESULT=$?
else
  # Linux/macOS环境使用Bash脚本
  bash scripts/quality/design-system-check.sh
  DESIGN_CHECK_RESULT=$?
fi

if [ $DESIGN_CHECK_RESULT -ne 0 ]; then
  echo ""
  echo "❌ 设计系统检查失败！"
  echo "💡 请修复违规后再提交代码。"
  echo ""
  exit 1
fi

echo "✅ 设计系统检查通过！"
echo ""

