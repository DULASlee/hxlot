{
    "name": "@smartabp/component-genie-workspace",
    "version": "0.1.0",
    "private": true,
    "description": "ComponentGenie - 超微AI组件智能管理引擎",
    "keywords": [
        "ai",
        "component",
        "vue",
        "react",
        "typescript",
        "analysis"
    ],
    "author": "SmartAbp Team <team@smartabp.com>",
    "license": "MIT",
    "homepage": "https://github.com/smartabp/component-genie",
    "repository": {
        "type": "git",
        "url": "https://github.com/smartabp/component-genie.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=16.0.0",
        "pnpm": ">=8.0.0"
    },
    "packageManager": "pnpm@8.15.0",
    "scripts": {
        "build": "pnpm -r build",
        "dev": "pnpm -r dev",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "lint": "eslint . --ext .ts,.tsx,.vue",
        "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
        "type-check": "tsc --noEmit",
        "clean": "pnpm -r clean && rimraf dist",
        "prerelease": "pnpm build && pnpm test",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.0",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitest/ui": "^1.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.0",
        "typescript": "^5.0.0",
        "vitest": "^1.0.0"
    }
}