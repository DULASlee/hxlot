{
  "version": "1.0.0",
  "project": "SmartAbp",
  "description": "企业级代码质量配置",
  "global": {
    "autoFix": false,
    "failOnError": true,
    "failOnWarning": false,
    "maxWarnings": 10,
    "outputFormat": "detailed",
    "reportPath": "reports/quality"
  },
  "paths": {
    "frontend": {
      "include": [
        "src/SmartAbp.Vue/src/**/*.{ts,vue,js}",
        "src/SmartAbp.Vue/packages/**/*.{ts,vue,js}"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/*.d.ts",
        "**/tests/**",
        "**/__tests__/**"
      ]
    },
    "backend": {
      "include": [
        "src/**/*.cs"
      ],
      "exclude": [
        "**/obj/**",
        "**/bin/**",
        "**/Migrations/**",
        "**/*.Designer.cs"
      ]
    }
  },
  "scoring": {
    "weights": {
      "typeSafety": 25,
      "codeStyle": 15,
      "architecture": 25,
      "performance": 15,
      "security": 10,
      "maintainability": 10
    },
    "thresholds": {
      "excellent": 95,
      "good": 90,
      "acceptable": 85,
      "poor": 70
    }
  },
  "qualityGate": {
    "P0": {
      "description": "阻断性问题（必须解决）",
      "failBuild": true,
      "maxViolations": 0
    },
    "P1": {
      "description": "严重问题（强烈建议解决）",
      "failBuild": true,
      "maxViolations": 0
    },
    "P2": {
      "description": "一般问题（建议解决）",
      "failBuild": false,
      "maxViolations": 10
    }
  }
}