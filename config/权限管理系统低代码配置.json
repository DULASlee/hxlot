{
    "systemName": "SmartAbp",
    "moduleName": "PermissionManagement",
    "displayName": "权限管理系统",
    "description": "企业级权限管理系统 - 通过低代码引擎生成（吃自己的狗粮）",
    "databaseProvider": "SqlServer",
    "entities": [
        {
            "name": "Menu",
            "displayName": "菜单管理",
            "description": "系统菜单和路由管理",
            "tableName": "AppMenus",
            "primaryKey": "Id",
            "hasAuditFields": true,
            "hasMultiTenant": true,
            "hasSoftDelete": false,
            "fields": [
                {
                    "name": "Name",
                    "displayName": "菜单名称",
                    "type": "String",
                    "maxLength": 100,
                    "required": true,
                    "description": "菜单名称（英文，如：user-management）",
                    "uiComponent": "Input",
                    "validationRules": [
                        "Required",
                        "MaxLength:100"
                    ]
                },
                {
                    "name": "Code",
                    "displayName": "菜单编码",
                    "type": "String",
                    "maxLength": 50,
                    "required": true,
                    "description": "菜单编码（全局唯一，如：SYSTEM_USER_MGMT）",
                    "uiComponent": "Input",
                    "validationRules": [
                        "Required",
                        "MaxLength:50",
                        "Unique"
                    ]
                },
                {
                    "name": "Title",
                    "displayName": "菜单标题",
                    "type": "String",
                    "maxLength": 200,
                    "required": true,
                    "description": "菜单标题（显示名称，支持多语言key）",
                    "uiComponent": "Input",
                    "validationRules": [
                        "Required",
                        "MaxLength:200"
                    ]
                },
                {
                    "name": "ParentId",
                    "displayName": "父菜单",
                    "type": "Guid",
                    "nullable": true,
                    "description": "父菜单ID",
                    "uiComponent": "TreeSelect",
                    "relationEntity": "Menu",
                    "relationDisplayField": "Title"
                },
                {
                    "name": "Type",
                    "displayName": "菜单类型",
                    "type": "Enum",
                    "enumType": "MenuType",
                    "required": true,
                    "description": "菜单类型：目录/菜单/按钮",
                    "uiComponent": "Select",
                    "enumOptions": [
                        {
                            "value": 1,
                            "label": "目录",
                            "description": "父节点，不对应具体页面"
                        },
                        {
                            "value": 2,
                            "label": "菜单",
                            "description": "对应具体页面"
                        },
                        {
                            "value": 3,
                            "label": "按钮",
                            "description": "页面内操作按钮"
                        },
                        {
                            "value": 4,
                            "label": "外部链接",
                            "description": "外部链接"
                        },
                        {
                            "value": 5,
                            "label": "内嵌页面",
                            "description": "内嵌iframe页面"
                        }
                    ]
                },
                {
                    "name": "Icon",
                    "displayName": "图标",
                    "type": "String",
                    "maxLength": 100,
                    "description": "图标（支持多种图标库）",
                    "uiComponent": "IconPicker"
                },
                {
                    "name": "RoutePath",
                    "displayName": "路由路径",
                    "type": "String",
                    "maxLength": 300,
                    "description": "Vue路由路径（如：/system/users）",
                    "uiComponent": "Input"
                },
                {
                    "name": "ComponentPath",
                    "displayName": "组件路径",
                    "type": "String",
                    "maxLength": 300,
                    "description": "组件路径（如：@/views/system/UserManagement.vue）",
                    "uiComponent": "Input"
                },
                {
                    "name": "PermissionCode",
                    "displayName": "权限编码",
                    "type": "String",
                    "maxLength": 200,
                    "description": "权限编码（如：System.Users.View）",
                    "uiComponent": "Input"
                },
                {
                    "name": "IsVisible",
                    "displayName": "是否显示",
                    "type": "Boolean",
                    "defaultValue": true,
                    "description": "是否在菜单中显示",
                    "uiComponent": "Switch"
                },
                {
                    "name": "IsEnabled",
                    "displayName": "是否启用",
                    "type": "Boolean",
                    "defaultValue": true,
                    "description": "是否启用（禁用后无法访问）",
                    "uiComponent": "Switch"
                },
                {
                    "name": "Sort",
                    "displayName": "排序号",
                    "type": "Integer",
                    "defaultValue": 0,
                    "description": "排序号（同级菜单内排序）",
                    "uiComponent": "InputNumber"
                },
                {
                    "name": "IsExternal",
                    "displayName": "外部链接",
                    "type": "Boolean",
                    "defaultValue": false,
                    "description": "是否外部链接",
                    "uiComponent": "Switch"
                },
                {
                    "name": "ExternalUrl",
                    "displayName": "外部链接地址",
                    "type": "String",
                    "maxLength": 500,
                    "description": "外部链接地址",
                    "uiComponent": "Input"
                }
            ],
            "relations": [
                {
                    "type": "SelfReference",
                    "relationField": "ParentId",
                    "navigationProperty": "Parent",
                    "collectionProperty": "Children"
                }
            ],
            "indexes": [
                {
                    "fields": [
                        "Code"
                    ],
                    "unique": true
                },
                {
                    "fields": [
                        "ParentId",
                        "Sort"
                    ]
                },
                {
                    "fields": [
                        "Type",
                        "IsVisible"
                    ]
                }
            ]
        },
