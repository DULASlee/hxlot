{
  "name": "smartabp-lowcode-quality",
  "version": "1.0.0",
  "description": "SmartAbp低代码引擎质量保障系统",
  "scripts": {
    "quality:check": "node src/SmartAbp.Vue/scripts/code-quality-engine.js",
    "quality:security": "node src/SmartAbp.Vue/scripts/security-scanner.js",
    "quality:performance": "node src/SmartAbp.Vue/scripts/performance-analyzer.js",
    "quality:full": "npm run quality:check && npm run quality:security && npm run quality:performance",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "perf:analyze": "node src/SmartAbp.Vue/scripts/performance-benchmark.js",
    "lint": "eslint src/SmartAbp.CodeGenerator --ext .cs,.ts,.js",
    "lint:fix": "eslint src/SmartAbp.CodeGenerator --ext .cs,.ts,.js --fix",
    "security:scan": "npm audit --production",
    "security:snyk": "npx snyk test --all-projects",
    "build": "dotnet build src/SmartAbp.CodeGenerator/SmartAbp.CodeGenerator.csproj --configuration Release",
    "clean": "dotnet clean && rm -rf quality-reports security-reports performance-reports"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-istanbul": "^1.0.0",
    "chalk": "^4.1.0",
    "snyk": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "lowcode",
    "quality",
    "security",
    "performance",
    "testing",
    "automation"
  ],
  "author": "SmartAbp Quality Team",
  "license": "MIT"
}