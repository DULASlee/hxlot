<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>smartabp-aspire-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.0.0-preview.1" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="9.0.0-preview.1" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="9.0.0-preview.1" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="9.0.0-preview.1" />
    <PackageReference Include="Aspire.Hosting.Elasticsearch" Version="9.0.0-preview.1" />
    <PackageReference Include="Aspire.Hosting.Dapr" Version="9.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAbp.Web\SmartAbp.Web.csproj" />
    <ProjectReference Include="..\SmartAbp.OpsManagement.Service\Host\SmartAbp.OpsManagement.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="prometheus\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="grafana\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

