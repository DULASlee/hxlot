<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\common.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591;NU1903;NU1902</NoWarn>

    <!-- 🏢 企业版特性：禁用默认嵌入资源，手动控制模板嵌入 -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Build" Version="17.14.8" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.8" />

    <!-- Roslyn and Code Analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Pluralize.NET" Version="1.0.2" />

    <!-- ABP Framework -->
    <PackageReference Include="Volo.Abp.Core" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.SignalR" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Authorization" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AutoMapper" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Ddd.Application" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.EventBus" Version="$(AbpVersion)" />
    <!-- Removed: Volo.Abp.Studio.Core 2.0.0 - Package not available on nuget.org -->
    <!-- Removed: Volo.Abp.EventBus.Local - Package not available on nuget.org -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />

    <!-- SignalR -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.1.0" />

    <!-- Microsoft Extensions -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />

    <!-- Other Dependencies -->
    <PackageReference Include="System.Threading.Channels" Version="9.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
    <PackageReference Include="MediatR" Version="12.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.0" />
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />

    <!-- ⭐ Phase 1.5新增：Handlebars.Net模板引擎 -->
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />

    <!-- Database providers for schema introspection -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
    <PackageReference Include="Npgsql" Version="8.0.4" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="3.21.130" />
  </ItemGroup>

  <!-- 🔥 ABP集成修复：添加必要的项目引用，遵循ABP架构最佳实践 -->
  <ItemGroup>
    <ProjectReference Include="..\SmartAbp.Application.Contracts\SmartAbp.Application.Contracts.csproj" />
    <ProjectReference Include="..\SmartAbp.Domain.Shared\SmartAbp.Domain.Shared.csproj" />
  </ItemGroup>

  <!-- 🏢 企业版特性：内嵌模板资源配置 - 容器化环境零配置部署 -->
  <ItemGroup>
    <!-- 后端模板文件 -->
    <EmbeddedResource Include="..\..\templates\backend\application\*.template.*">
      <LogicalName>SmartAbp.CodeGenerator.Templates.backend.application.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\backend\contracts\*.template.*">
      <LogicalName>SmartAbp.CodeGenerator.Templates.backend.contracts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- 前端模板文件 -->
    <EmbeddedResource Include="..\..\templates\frontend\components\*.template.*">
      <LogicalName>SmartAbp.CodeGenerator.Templates.frontend.components.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\frontend\stores\*.template.*">
      <LogicalName>SmartAbp.CodeGenerator.Templates.frontend.stores.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\frontend\router\*.template.*">
      <LogicalName>SmartAbp.CodeGenerator.Templates.frontend.router.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- 低代码引擎模板文件 -->
    <EmbeddedResource Include="..\..\templates\lowcode\**\*.template.*">
      <LogicalName>SmartAbp.CodeGenerator.Templates.lowcode.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>

    <!-- 模板索引和配置文件 -->
    <EmbeddedResource Include="..\..\templates\index.json">
      <LogicalName>SmartAbp.CodeGenerator.Templates.index.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\EXPERT_MODE_CONFIG.json">
      <LogicalName>SmartAbp.CodeGenerator.Templates.EXPERT_MODE_CONFIG.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
