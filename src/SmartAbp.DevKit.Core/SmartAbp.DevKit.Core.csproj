<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet包元数据 -->
    <PackageId>SmartAbp.DevKit.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>SmartAbp Team</Authors>
    <Company>SmartAbp</Company>
    <Description>SmartAbp DevKit核心工具包 - 为SmartAbp项目提供全栈代码自动生成能力</Description>
    <PackageTags>smartabp;devkit;codegen;code-generator;abp;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/SmartAbp/hxlot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SmartAbp/hxlot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 2: DevKit核心依赖 -->
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- ⭐ D爷建议：硬伤2修复 - 内存缓存 -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.10" />

    <!-- ABP Framework依赖（Week 4-5集成） -->
    <PackageReference Include="Volo.Abp.Core" Version="9.3.6" />
    <PackageReference Include="Volo.Abp.Autofac" Version="9.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />

    <!-- ⭐ Week 1 Day 5: 企业级数据库支持 -->
    <!-- SQL Server LocalDB -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <!-- PostgreSQL -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
    <!-- 异步日志通道 -->
    <PackageReference Include="System.Threading.Channels" Version="9.0.0" />
    <!-- 对象池（性能优化） -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="9.0.0" />
    <!-- xxHash3哈希算法（增量生成） -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 删除业务依赖 -->
    <!--
    <ProjectReference Include="..\SmartAbp.Domain\SmartAbp.Domain.csproj" />
    <ProjectReference Include="..\SmartAbp.Application.Contracts\SmartAbp.Application.Contracts.csproj" />
    -->

    <!-- 添加抽象层依赖 -->
    <ProjectReference Include="..\SmartAbp.DevKit.Abstractions\SmartAbp.DevKit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet包内容 -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\devkit.config.json" Pack="true" PackagePath="content\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 前端生成器脚本 -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.10" />
    <None Include="Scripts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

