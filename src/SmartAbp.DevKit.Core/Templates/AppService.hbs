            // Example: query = query.WhereIf(!string.IsNullOrEmpty(input.Filter), x => x.Name.Contains(input.Filter));

            var totalCount = await AsyncExecuter.CountAsync(query);

            // 排序
            query = ApplySorting(query, input);

            // 分页
            query = ApplyPaging(query, input);

            var entities = await AsyncExecuter.ToListAsync(query);

            return new PagedResultDto<{{pascalCase Name}}Dto>(
                totalCount,
                ObjectMapper.Map<System.Collections.Generic.List<{{pascalCase Name}}>, System.Collections.Generic.List<{{pascalCase Name}}Dto>>(entities)
