        public override async Task<{{pascalCase Name}}Dto> UpdateAsync(Guid id, Update{{pascalCase Name}}Dto input)
        {
            var entity = await Repository.GetAsync(id);

            ObjectMapper.Map(input, entity);

            await Repository.UpdateAsync(entity);
            await CurrentUnitOfWork.SaveChangesAsync();

            return ObjectMapper.Map<{{pascalCase Name}}, {{pascalCase Name}}Dto>(entity);
        }

        /// <summary>
