# ======================================
# SmartAbp Vue 项目编辑器配置
# 确保所有IDE的一致性体验
# ======================================

# 顶级配置
root = true

# 所有文件的通用配置
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# TypeScript/JavaScript 文件
[*.{ts,tsx,js,jsx}]
indent_size = 2
quote_type = single

# Vue 单文件组件
[*.vue]
indent_size = 2

# JSON 文件
[*.json]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# Markdown 文件
[*.{md,mdc}]
trim_trailing_whitespace = false
max_line_length = off

# Package.json 特殊配置
[package.json]
indent_size = 2

# 配置文件
[*.{config.js,config.ts}]
indent_size = 2

# 样式文件
[*.{css,scss,sass,less}]
indent_size = 2

# HTML 文件
[*.html]
indent_size = 2

# XML 文件
[*.xml]
indent_size = 2

# Shell 脚本
[*.{sh,bash}]
end_of_line = lf

# Windows 批处理文件
[*.{bat,cmd}]
end_of_line = crlf

# C# 文件 (后端)
[*.cs]
indent_size = 4
end_of_line = crlf

# .NET 项目文件
[*.{csproj,sln,props,targets}]
indent_size = 2
end_of_line = crlf
