# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SmartAbp Vue 项目 - NPM配置
# 🛡️ 第3层保护：包管理策略
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Workspace协议（Monorepo内部引用优先）
# 确保 @smartabp/* 包优先使用本地workspace版本
link-workspace-packages=true

# 严格模式（推荐生产环境）
# 确保package-lock.json与package.json一致
package-lock=true

# 自动安装peer dependencies
auto-install-peers=true

# 保存精确版本号（安全第一）
save-exact=true

# 禁止提升（Hoist）@smartabp包到根node_modules
# 确保各package使用自己的依赖版本
public-hoist-pattern[]=!@smartabp/*

# 严格的peer dependencies检查
strict-peer-dependencies=true

# 日志级别
loglevel=warn

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 安全策略
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 审计级别（忽略低危漏洞，关注中高危）
audit-level=moderate

# 仅生产依赖审计
audit=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 性能优化（Mac Pro ARM专用）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 使用硬链接（节省磁盘空间）
package-import-method=hardlink

# 并发安装（利用多核）
network-concurrency=16

# 缓存目录（SSD优化）
cache-dir=~/.npm

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 注意事项:
# 1. @smartabp/* 包永远使用workspace:*版本
# 2. 外部包使用精确版本号（无^或~）
# 3. 修改此文件后需重新 npm install
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

