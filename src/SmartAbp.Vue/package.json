{
  "name": "smartabp.vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:packages": "npm run build:packages:types && npm run build:packages:dist",
    "build:packages:types": "npx tsc --build tsconfig.references.json",
    "build:packages:dist": "node scripts/build-packages.js",
    "stylelint": "stylelint \"src/views/codegen/designer/**/*.{css,scss,vue}\" \"src/views/codegen/VisualDesignerView.vue\" \"src/styles/**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"src/views/codegen/designer/**/*.{css,scss,vue}\" \"src/views/codegen/VisualDesignerView.vue\" \"src/styles/**/*.{css,scss,vue}\" --fix",
    "gen:api": "openapi --input %VITE_API_BASE_URL%/swagger/v1/swagger.json --output src/core/api --client axios",
    "gen:api:ci": "openapi --input $VITE_API_BASE_URL/swagger/v1/swagger.json --output src/core/api --client axios",
    "gen:api:check": "git diff --exit-code src/core/api || (echo API client drift detected && exit 1)",
    "dev": "vite",
    "dev:fast": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vite --force",
    "build": "run-s type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:packages": "tsc -b tsconfig.references.json",
    "type-check:all": "npm-run-all -p type-check type-check:packages",
    "type-gen": "tsx scripts/generate-types.ts",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" --fix",
    "format": "prettier --write .",
    "qa:check": "npm-run-all -s type-check lint test:coverage build-only",
    "precommit-check": "npm-run-all -s type-check lint test:coverage",
    "prepare": "husky install",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "codegen": "tsx src/tools/cli.ts generate",
    "codegen:check": "tsx src/tools/cli.ts check",
    "codegen:entity": "tsx --tsconfig tsconfig.json src/tools/metadata-codegen.ts",
    "diagnose:components": "tsx ../../scripts/tools/diagnose-component-system.ts",
    "codegen:frontend": "tsx --tsconfig tsconfig.json src/tools/metadata-codegen.ts frontend",
    "codegen:backend": "tsx --tsconfig tsconfig.json src/tools/metadata-codegen.ts backend",
    "codegen:all": "tsx --tsconfig tsconfig.json src/tools/metadata-codegen.ts all",
    "module:add": "tsx src/tools/add-module.ts --input",
    "module:add:codegen": "tsx src/tools/add-module.ts --input --codegen",
    "security-check": "tsx src/tools/security-check.ts",
    "validate-inputs": "tsx src/tools/validate-inputs.ts",
    "dangerous-patterns": "tsx src/tools/dangerous-patterns.ts",
    "perf:analyze": "node scripts/performance-analysis.js full",
    "perf:bundle": "node scripts/performance-analysis.js bundle",
    "validate:workspace": "node scripts/validate-workspace.cjs",
    "preinstall": "node scripts/validate-workspace.cjs || echo '⚠️  Workspace validation skipped (first install)'",
    "perf:build": "node scripts/performance-analysis.js build",
    "perf:lighthouse": "node scripts/performance-analysis.js lighthouse",
    "build:analyze": "cross-env ANALYZE_BUNDLE=true npm run build",
    "build:no-tree-shaking": "cross-env TREE_SHAKING=false npm run build",
    "serve": "vite preview --port 8080",
    "bundle:visualize": "npx webpack-bundle-analyzer dist/analysis/bundle-stats.json",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "npx http-server storybook-static",
    "storybook:test": "test-storybook",
    "chromatic": "npx chromatic --project-token=PROJECT_TOKEN",
    "validate:final": "node scripts/final-validation.js",
    "deploy:prepare": "npm run validate:final && npm run build && npm run storybook:build",
    "packages:build": "node scripts/build-packages-fast.js",
    "packages:build:legacy": "node scripts/build-packages.js",
    "packages:version": "node scripts/version-packages.js",
    "packages:version:list": "node scripts/version-packages.js list",
    "packages:version:bump": "node scripts/version-packages.js bump",
    "packages:version:bump:major": "node scripts/version-packages.js bump major",
    "packages:version:bump:minor": "node scripts/version-packages.js bump minor",
    "packages:version:bump:patch": "node scripts/version-packages.js bump patch",
    "packages:version:sync": "node scripts/version-packages.js sync",
    "packages:publish": "node scripts/publish-packages.js",
    "packages:publish:dry": "node scripts/publish-packages.js --dry-run",
    "packages:publish:beta": "node scripts/publish-packages.js --tag=beta",
    "packages:full-release": "npm run packages:build && npm run packages:publish:dry",
    "packages:test": "vitest --config packages/vitest.config.ts",
    "packages:test:ui": "vitest --ui --config packages/vitest.config.ts",
    "packages:test:coverage": "vitest run --coverage --config packages/vitest.config.ts",
    "packages:perf": "node scripts/test-packages-performance.js",
    "packages:precheck": "node scripts/pre-publish-check.js",
    "packages:release": "npm run packages:build && npm run packages:precheck && npm run packages:publish:dry",
    "perf:baseline": "node scripts/performance-baseline-test.js",
    "perf:web-vitals": "node scripts/web-vitals-report.js",
    "perf:full-analysis": "npm run perf:baseline && npm run perf:analyze",
    "validate:components": "node scripts/validate-component-names.cjs",
    "analyze:components": "node scripts/analyze-component-system.cjs",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,css,scss,vue,html,md}\"",
    "quality": "quality-guardian check",
    "arch:check": "tsx scripts/arch-check.ts check",
    "arch:fix": "tsx scripts/arch-check.ts fix",
    "arch:report": "tsx scripts/arch-check.ts report"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,tsx,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@form-create/element-ui": "3.2.31",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@iconify/vue": "^5.0.0",
    "@microsoft/signalr": "^9.0.6",
    "@smartabp/lowcode-core": "file:./packages/lowcode-core",
    "@smartabp/lowcode-designer": "file:./packages/lowcode-designer",
    "@smartabp/lowcode-shared": "file:./packages/lowcode-shared",
    "@smartabp/lowcode-tools": "file:./packages/lowcode-tools",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.47.0",
    "@vue/compiler-core": "^3.5.13",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/compiler-sfc": "^3.5.13",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "echarts": "^6.0.0",
    "element-plus": "^2.8.8",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.44.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "source-map": "^0.7.4",
    "uuid": "^9.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@iconify-json/carbon": "^1.2.13",
    "@iconify-json/ep": "^1.2.3",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.49.0",
    "@rushstack/eslint-patch": "^1.13.0",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/test-runner": "^0.23.0",
    "@storybook/vue3-vite": "^9.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/cypress": "^0.1.6",
    "@types/echarts": "^4.9.22",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.20",
    "c8": "^10.1.3",
    "chalk": "^4.1.2",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "cypress": "^15.1.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-visualstudio": "^8.40.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "^9.1.10",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "lighthouse": "^12.2.1",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript-codegen": "^0.29.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.6.2",
    "puppeteer": "^23.10.4",
    "sass": "^1.91.0",
    "storybook": "^9.1.7",
    "storybook-addon-pseudo-states": "^9.1.7",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "terser-webpack-plugin": "^5.3.10",
    "tsx": "^4.6.0",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-icons": "^22.2.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.1",
    "vitest": "^3.2.4",
    "vue-i18n": "^9.14.5",
    "vue-tsc": "^3.1.0",
    "web-vitals": "^5.1.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "vite-plugin-compression": "^0.5.1"
  }
}
