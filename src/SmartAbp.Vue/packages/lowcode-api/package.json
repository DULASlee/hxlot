{
  "name": "@smartabp/lowcode-api",
  "version": "1.0.0",
  "description": "SmartAbp LowCode API Layer",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./src/index.ts"
    },
    "./http-client": {
      "types": "./dist/http-client/index.d.ts",
      "import": "./dist/esm/http-client/index.js",
      "require": "./dist/cjs/http-client/index.js"
    },
    "./generators": {
      "types": "./dist/generators/index.d.ts",
      "import": "./dist/esm/generators/index.js",
      "require": "./dist/cjs/generators/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/esm/composables/index.js",
      "require": "./dist/cjs/composables/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc --project tsconfig.cjs.json",
    "build:tsup": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "smartabp",
    "lowcode",
    "api"
  ],
  "author": "SmartAbp Team",
  "license": "MIT",
  "peerDependencies": {
    "@smartabp/lowcode-shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "tsup": "^8.0.0"
  }
}