{
  "name": "@smartabp/lowcode-core",
  "version": "1.0.0",
  "description": "SmartAbp LowCode Core Engine - State Management and Core Logic",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./generators": {
      "types": "./dist/generators/index.d.ts",
      "import": "./dist/generators/index.mjs",
      "require": "./dist/generators/index.js"
    },
    "./engines": {
      "types": "./dist/engines/index.d.ts",
      "import": "./dist/engines/index.mjs",
      "require": "./dist/engines/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.mjs",
      "require": "./dist/security/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "SmartAbp Team",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "typescript": "^5.0.0",
    "vue": "^3.3.0"
  },
  "peerDependencies": {
    "@smartabp/lowcode-api": "workspace:*",
    "@smartabp/lowcode-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsup": "^8.0.0",
    "vite": "7.1.12"
  }
}
