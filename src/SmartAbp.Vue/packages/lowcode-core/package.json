{
  "name": "@smartabp/lowcode-core",
  "version": "1.0.0",
  "description": "SmartAbp LowCode Core Engine - State Management and Core Logic",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./generators": {
      "types": "./dist/esm/generators/index.d.ts",
      "import": "./dist/esm/generators/index.js",
      "require": "./dist/cjs/generators/index.js"
    },
    "./engines": {
      "types": "./dist/esm/engines/index.d.ts",
      "import": "./dist/esm/engines/index.js",
      "require": "./dist/cjs/engines/index.js"
    },
    "./security": {
      "types": "./dist/esm/security/index.d.ts",
      "import": "./dist/esm/security/index.js",
      "require": "./dist/cjs/security/index.js"
    },
    "./testing": {
      "types": "./dist/esm/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "SmartAbp Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc && tsc --project tsconfig.cjs.json && node scripts/copy-vue-files.mjs",
    "build:tsup": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "vue": "^3.3.0"
  },
  "peerDependencies": {
    "@smartabp/lowcode-api": "workspace:*",
    "@smartabp/lowcode-shared": "workspace:*",
    "@smartabp/metadata-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.3"
  }
}