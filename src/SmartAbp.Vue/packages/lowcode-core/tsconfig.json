{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@smartabp/lowcode-shared": ["../lowcode-shared/dist/index.js"],
      "@smartabp/lowcode-shared/*": ["../lowcode-shared/dist/*"],
      "@smartabp/lowcode-core": ["./dist/index.js"],
      "@smartabp/lowcode-core/*": ["./dist/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "dist",
    "**/*.md"
  ],
  "references": [
    { "path": "../lowcode-shared" }
  ]
}