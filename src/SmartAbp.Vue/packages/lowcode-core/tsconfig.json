{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "composite": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/generators/RelationshipUIGenerator.ts",
    "src/stores/codeGeneration.ts",
    "src/types/unified-metadata.ts",
    "src/utils/manifestWriter.ts"
  ],
  "references": [
    {
      "path": "../lowcode-shared"
    },
    {
      "path": "../metadata-core"
    },
    {
      "path": "../lowcode-api"
    }
  ]
}