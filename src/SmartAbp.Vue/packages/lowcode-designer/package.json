{
  "name": "@smartabp/lowcode-designer",
  "version": "1.0.0",
  "description": "SmartAbp LowCode Designer - Visual Design Tools",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "import": "./dist/views/index.mjs",
      "require": "./dist/views/index.js"
    }
  },
  "sideEffects": false,
  "author": "SmartAbp Team",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@smartabp/lowcode-core": "workspace:*",
    "@smartabp/lowcode-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "7.1.12"
  }
}
