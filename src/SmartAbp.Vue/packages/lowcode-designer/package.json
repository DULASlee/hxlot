{
  "name": "@smartabp/lowcode-designer",
  "version": "1.0.0",
  "description": "SmartAbp LowCode Designer - Visual Design Tools",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./dist/esm/components/index.d.ts",
      "import": "./dist/esm/components/index.js",
      "require": "./dist/cjs/components/index.js"
    },
    "./views": {
      "types": "./dist/esm/views/index.d.ts",
      "import": "./dist/esm/views/index.js",
      "require": "./dist/cjs/views/index.js"
    }
  },
  "sideEffects": false,
  "author": "SmartAbp Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc && tsc --project tsconfig.cjs.json && node scripts/copy-vue-files.mjs",
    "build:tsup": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@smartabp/lowcode-core": "workspace:*",
    "@smartabp/lowcode-shared": "workspace:*"
  },
  "devDependencies": {
    "@smartabp/metadata-core": "file:../metadata-core",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}