{
  "name": "@smartabp/lowcode-quality-guardian",
  "version": "2.0.0",
  "description": "SmartAbp Quality Guardian - 企业级全栈代码质量保障引擎",
  "private": false,
  "type": "module",
  "bin": {
    "quality-guardian": "./dist/cli.js",
    "smart-quality": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js --format=esm --external:chalk --external:commander --external:execa --external:fast-glob --external:fs-extra --external:@babel/parser --external:@babel/traverse --external:@vue/compiler-sfc && npm run build:post",
    "build:post": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts check --project-root .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "tsc --noEmit",
    "quality:self": "node dist/cli.js check --strict"
  },
  "dependencies": {
    "@babel/parser": "^7.24.7",
    "@babel/traverse": "^7.24.7",
    "@vue/compiler-sfc": "^3.4.29",
    "chalk": "^5.3.0",
    "commander": "12.1.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/fs-extra": "^11.0.4",
    "esbuild": "^0.19.2",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
