{
  "name": "@smartabp/lowcode-shared",
  "version": "1.0.0",
  "description": "SmartAbp LowCode Engine Shared Library - Unified Schema v1.0.0 + Memory Safe Utilities",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./validation": {
      "types": "./dist/esm/validation/index.d.ts",
      "import": "./dist/esm/validation/index.js",
      "require": "./dist/cjs/validation/index.js"
    },
    "./validation/adapter": {
      "types": "./dist/esm/validation/adapter.d.ts",
      "import": "./dist/esm/validation/adapter.js",
      "require": "./dist/cjs/validation/adapter.js"
    },
    "./version": {
      "types": "./dist/esm/version/index.d.ts",
      "import": "./dist/esm/version/index.js",
      "require": "./dist/cjs/version/index.js"
    },
    "./cache": {
      "types": "./dist/esm/cache/index.d.ts",
      "import": "./dist/esm/cache/index.js",
      "require": "./dist/cjs/cache/index.js"
    },
    "./memory": {
      "types": "./dist/esm/memory/index.d.ts",
      "import": "./dist/esm/memory/index.js",
      "require": "./dist/cjs/memory/index.js"
    },
    "./events": {
      "types": "./dist/esm/events/index.d.ts",
      "import": "./dist/esm/events/index.js",
      "require": "./dist/cjs/events/index.js"
    },
    "./logging": {
      "types": "./dist/esm/logging/index.d.ts",
      "import": "./dist/esm/logging/index.js",
      "require": "./dist/cjs/logging/index.js"
    },
    "./error": {
      "types": "./dist/esm/error/index.d.ts",
      "import": "./dist/esm/error/index.js",
      "require": "./dist/cjs/error/index.js"
    },
    "./theme": {
      "types": "./dist/esm/theme/index.d.ts",
      "import": "./dist/esm/theme/index.js",
      "require": "./dist/cjs/theme/index.js"
    },
    "./components": {
      "types": "./dist/esm/components/index.d.ts",
      "import": "./dist/esm/components/index.js",
      "require": "./dist/cjs/components/index.js"
    },
    "./components/*": {
      "types": "./dist/esm/components/*.d.ts",
      "import": "./dist/esm/components/*.js",
      "require": "./dist/cjs/components/*.js"
    },
    "./composables": {
      "types": "./dist/esm/composables/index.d.ts",
      "import": "./dist/esm/composables/index.js",
      "require": "./dist/cjs/composables/index.js"
    },
    "./validators": {
      "types": "./dist/esm/validators/index.d.ts",
      "import": "./dist/esm/validators/index.js",
      "require": "./dist/cjs/validators/index.js"
    },
    "./constants": {
      "types": "./dist/esm/constants/index.d.ts",
      "import": "./dist/esm/constants/index.js",
      "require": "./dist/cjs/constants/index.js"
    },
    "./plugins": {
      "types": "./dist/esm/plugins/index.d.ts",
      "import": "./dist/esm/plugins/index.js",
      "require": "./dist/cjs/plugins/index.js"
    },
    "./ai": {
      "types": "./dist/esm/ai/index.d.ts",
      "import": "./dist/esm/ai/index.js",
      "require": "./dist/cjs/ai/index.js"
    },
    "./performance": {
      "types": "./dist/esm/performance/index.d.ts",
      "import": "./dist/esm/performance/index.js",
      "require": "./dist/cjs/performance/index.js"
    },
    "./utils": {
      "types": "./dist/esm/utils/index.d.ts",
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js"
    },
    "./types": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.js"
    },
    "./types/*": {
      "types": "./dist/esm/types/*.d.ts",
      "import": "./dist/esm/types/*.js",
      "require": "./dist/cjs/types/*.js"
    },
    "./i18n": {
      "types": "./dist/esm/i18n/index.d.ts",
      "import": "./dist/esm/i18n/index.js",
      "require": "./dist/cjs/i18n/index.js"
    }
  },
  "sideEffects": false,
  "author": "SmartAbp Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc && tsc --project tsconfig.cjs.json && node scripts/copy-vue-files.mjs",
    "build:tsup": "tsup",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "typescript": "^5.0.0",
    "glob": "^10.3.10"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@smartabp/metadata-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "zod": "^4.1.11"
  }
}