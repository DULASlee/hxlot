{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "composite": true,
    "skipLibCheck": true,
    "paths": {
      "@smartabp/lowcode-shared": ["./src/index.ts"],
      "@smartabp/lowcode-shared/*": ["./src/*"],
      "@smartabp/lowcode-shared/types": ["./src/types/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/validation/__tests__/**/*",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
  "references": [
    {
      "path": "../metadata-core"
    }
  ]
}
