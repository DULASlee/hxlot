{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2016",
    "module": "esnext",
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@smartabp/lowcode-shared": ["../lowcode-shared/src/index.ts"],
      "@smartabp/lowcode-shared/*": ["../lowcode-shared/src/*"],
      "@smartabp/lowcode-tools": ["./src/index.ts"],
      "@smartabp/lowcode-tools/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "dist"
  ],
  "references": [
    { "path": "../lowcode-shared" }
  ]
}