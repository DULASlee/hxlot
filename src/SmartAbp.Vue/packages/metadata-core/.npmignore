# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# @smartabp/metadata-core - NPM发布白名单配置
# 🛡️ 第1层保护：发布文件过滤（避免敏感信息泄露）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 开发文件（不发布）
src/
__tests__/
*.test.ts
*.spec.ts
test.js

# 配置文件（不发布）
tsconfig.json
tsup.config.ts
vitest.config.ts
.eslintrc.*
.prettierrc
.editorconfig

# 文档（选择性发布，保留README.md）
PUBLISH-GUIDE.md
NPM-PACKAGE-READINESS.md
INTEGRATION-PLAN.md
ARCHITECTURE.md
REAL-CAPABILITIES.md

# 版本控制（不发布）
.git
.gitignore
.gitattributes

# 依赖（不发布）
node_modules/

# 日志（不发布）
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE配置（不发布）
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件（不发布）
.DS_Store
Thumbs.db
*.tmp
*.bak

# CI/CD（不发布）
.github/
.gitlab-ci.yml
.travis.yml

# 覆盖率报告（不发布）
coverage/
.nyc_output/

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 仅发布以下内容:
# - dist/ (构建产物)
# - README.md (基础文档)
# - LICENSE (许可证)
# - package.json (包配置)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

