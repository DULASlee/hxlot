{
    "name": "@smartabp/quality-guardian",
    "version": "1.0.0",
    "description": "SmartAbp企业级低代码质量检测工具",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "smartabp-quality": "./bin/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./checkers": {
            "types": "./dist/checkers/index.d.ts",
            "import": "./dist/checkers/index.js"
        }
    },
    "files": [
        "dist",
        "bin"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest",
        "lint": "eslint src/**/*.ts",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "smartabp",
        "lowcode",
        "quality",
        "code-generation",
        "enterprise"
    ],
    "author": "SmartAbp Team",
    "license": "Commercial",
    "engines": {
        "node": ">=16.0.0"
    },
    "peerDependencies": {
        "@smartabp/lowcode-shared": "workspace:*",
        "@smartabp/lowcode-core": "workspace:*"
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "commander": "^9.4.1"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "typescript": "^5.0.0",
        "rollup": "^3.0.0",
        "vitest": "^0.34.0",
        "eslint": "^8.0.0"
    }
}