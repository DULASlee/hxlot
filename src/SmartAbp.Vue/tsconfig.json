{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "ES2021.WeakRef", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    // ⚠️ 移除types限制，让TypeScript自动扫描node_modules/@types
    // "types": ["./types/components.d.ts"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,  // TODO: 逐步修复后改为true
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@smartabp/lowcode-api": ["packages/lowcode-api/src/index.ts"],
      "@smartabp/lowcode-api/*": ["packages/lowcode-api/src/*"],
      "@smartabp/lowcode-core": ["packages/lowcode-core/src/index.ts"],
      "@smartabp/lowcode-core/*": ["packages/lowcode-core/src/*"],
      "@smartabp/lowcode-designer": ["packages/lowcode-designer/index.ts"],
      "@smartabp/lowcode-designer/*": ["packages/lowcode-designer/*"],
      "@smartabp/lowcode-codegen": ["packages/lowcode-codegen/index.ts"],
      "@smartabp/lowcode-codegen/*": ["packages/lowcode-codegen/*"],
      "@smartabp/lowcode-tools": ["packages/lowcode-tools/src/index.ts"],
      "@smartabp/lowcode-tools/*": ["packages/lowcode-tools/src/*"],
      "@smartabp/lowcode-shared": ["packages/lowcode-shared/src/index.ts"],
      "@smartabp/lowcode-shared/*": ["packages/lowcode-shared/src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // 🔥 防止 tsc 编译输出 .js 文件到源目录
    // Vite 会直接使用 .ts 源文件，不需要编译产物
    "noEmit": true
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/icon-types.d.ts",
    "src/**/*.vue",
    "src/**/*.tsx",
    // 🔥 移除 src/**/*.js - 不应该在源目录中包含编译产物
    // 如果存在同名 .js 和 .ts 文件，会导致模块解析冲突
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "build",
    "coverage",
    "cypress",
    "reports",
    "stories",
    "**/*.stories.ts",
    "**/*.stories.js",
    "**/*.stories.vue",
    "public",
    "scripts",
    "*.config.ts",
    "*.config.js",
    "src/tools/**",
    "src/views/library/**"
    // ⚠️ 移除packages/**排除，使用tsconfig.references.json管理
    // "packages/**"
  ]
}
