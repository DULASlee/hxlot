{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "ES2021.WeakRef", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@smartabp/lowcode-api": ["packages/lowcode-api/index.ts"],
      "@smartabp/lowcode-api/*": ["packages/lowcode-api/*"],
      "@smartabp/lowcode-core": ["packages/lowcode-core/index.ts"],
      "@smartabp/lowcode-core/*": ["packages/lowcode-core/*"],
      "@smartabp/lowcode-designer": ["packages/lowcode-designer/index.ts"],
      "@smartabp/lowcode-designer/*": ["packages/lowcode-designer/*"],
      "@smartabp/lowcode-codegen": ["packages/lowcode-codegen/index.ts"],
      "@smartabp/lowcode-codegen/*": ["packages/lowcode-codegen/*"],
      "@smartabp/lowcode-tools": ["packages/lowcode-tools/index.ts"],
      "@smartabp/lowcode-tools/*": ["packages/lowcode-tools/*"],
      "@smartabp/lowcode-shared": ["packages/lowcode-shared/src/index.ts"],
      "@smartabp/lowcode-shared/*": ["packages/lowcode-shared/src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/icon-types.d.ts",
    "src/**/*.vue",
    "src/**/*.tsx",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "build",
    "coverage",
    "cypress",
    "reports",
    "stories",
    "**/*.stories.ts",
    "**/*.stories.js",
    "**/*.stories.vue",
    "public",
    "scripts",
    "*.config.ts",
    "*.config.js"
  ]
}
