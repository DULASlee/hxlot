{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "ES2021.WeakRef", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@smartabp/lowcode-api": ["packages/lowcode-api/index.ts"],
      "@smartabp/lowcode-api/*": ["packages/lowcode-api/*"],
      "@smartabp/lowcode-core": ["packages/lowcode-core/src"],
      "@smartabp/lowcode-core/*": ["packages/lowcode-core/src/*"],
      "@smartabp/lowcode-designer": ["packages/lowcode-designer/src"],
      "@smartabp/lowcode-designer/*": ["packages/lowcode-designer/src/*"],
      "@smartabp/lowcode-codegen": ["packages/lowcode-codegen/src"],
      "@smartabp/lowcode-codegen/*": ["packages/lowcode-codegen/src/*"],
      "@smartabp/lowcode-tools": ["packages/lowcode-tools/src"],
      "@smartabp/lowcode-tools/*": ["packages/lowcode-tools/src/*"]
    },
    "types": ["vite/client", "element-plus/global"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/icon-types.d.ts",
    "src/**/*.vue",
    "src/**/*.tsx",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
