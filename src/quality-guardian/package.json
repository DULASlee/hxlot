{
  "name": "@smartabp/quality-guardian",
  "version": "2.0.0",
  "description": "SmartAbp Quality Guardian - 独立的企业级全栈代码质量检测工具",
  "private": false,
  "type": "module",
  "bin": {
    "quality-guardian": "./bin/quality-guardian",
    "smart-quality": "./bin/quality-guardian"
  },
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "build": "esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js --external:esbuild --external:chalk",
    "dev": "npm run build -- --watch",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@babel/parser": "^7.24.7",
    "@babel/traverse": "^7.24.7",
    "@vue/compiler-sfc": "^3.4.29",
    "chalk": "^5.3.0",
    "commander": "12.1.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.25",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/parser": "^7.1.0",
    "@typescript-eslint/typescript-estree": "^7.1.0",
    "esbuild": "^0.20.1",
    "tsx": "^4.15.7",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@vitest/ui": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}