<template>
  <div class="dashboard-container" :class="{ 'fullscreen': isFullscreen }">
    <!-- Dashboard 头部 -->
    <div class="dashboard-header">
      <div class="header-left">
        <h1 class="dashboard-title">{{ title }}</h1>
        <div class="update-time">
          最后更新: {{ lastUpdateTime }}
        </div>
      </div>
      <div class="header-right">
        <el-button 
          :icon="isFullscreen ? 'FullscreenExit' : 'Fullscreen'"
          @click="toggleFullscreen"
          circle
        />
        <el-button 
          :icon="isAutoRefresh ? 'VideoPause' : 'VideoPlay'"
          @click="toggleAutoRefresh"
          circle
        />
      </div>
    </div>

    <!-- Dashboard 主体 -->
    <div class="dashboard-body">
      <!-- KPI 指标卡片区域 -->
      <div class="kpi-section">
        <{{EntityName}}KPICard
          v-for="(kpi, index) in kpiData"
          :key="index"
          :label="kpi.label"
          :value="kpi.value"
          :unit="kpi.unit"
          :trend="kpi.trend"
          :change="kpi.change"
        />
      </div>

      <!-- 实时图表区域 -->
      <div class="charts-section">
        {{#each ChartConfigs}}
        <div class="chart-wrapper">
          <{{../EntityName}}RealtimeChart
            chart-id="{{ChartId}}"
            :chart-type="'{{ChartType}}'"
            :title="'{{Title}}'"
            :data-field="'{{DataField}}'"
            {{#if DataFields}}
            :data-fields="{{json DataFields}}"
            {{/if}}
            :is-realtime="{{IsRealtime}}"
            :max-data-points="{{MaxDataPoints}}"
            :update-interval="{{UpdateInterval}}"
          />
        </div>
        {{/each}}
      </div>
    </div>

    <!-- WebSocket 连接状态 -->
    <div class="connection-status" :class="connectionStatusClass">
      <el-icon><Connection /></el-icon>
      {{ connectionStatus }}
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted, onUnmounted, computed } from 'vue'
import { useRealtimeStore } from './realtime-store'
import { WebSocketClient } from './websocket-client'
import {{EntityName}}KPICard from './{{EntityName}}KPICard.vue'
import {{EntityName}}RealtimeChart from './{{EntityName}}RealtimeChart.vue'
import type { {{EntityName}}Dto } from '@/api/generated'

/**
 * Dashboard布局页面
 * 
 * 【功能】
 * - 显示KPI指标卡片
 * - 显示多个实时图表
 * - WebSocket实时数据连接
 * - 自动刷新机制
 * - 全屏模式
 * 
 * 【数据流】
 * WebSocket → RealtimeStore → KPI卡片/图表组件
 * 
 * @author SmartAbp DevKit Low-Code Engine
 * @since {{GeneratedTime}}
 */

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 状态管理
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

const realtimeStore = useRealtimeStore()
const wsClient = ref<WebSocketClient | null>(null)

// Dashboard配置
const title = ref('{{EntityName}} 实时监控大屏')
const isFullscreen = ref(false)
const isAutoRefresh = ref({{DashboardConfig.EnableAutoRefresh}})
const refreshInterval = {{DashboardConfig.RefreshInterval}} // ms

// 连接状态
const connectionStatus = computed(() => realtimeStore.connectionStatus)
const connectionStatusClass = computed(() => ({
  'status-connected': realtimeStore.isConnected,
  'status-disconnected': !realtimeStore.isConnected,
  'status-connecting': realtimeStore.connectionStatus === 'Connecting'
}))

// 更新时间
const lastUpdateTime = ref('')

// KPI数据（从store获取）
const kpiData = computed(() => {
  const data = realtimeStore.latestData
  if (!data) return []

  return [
    {{#each KpiFields}}
    {
      label: '{{Label}}',
      value: data.{{Name}} ?? 0,
      unit: '{{#if Unit}}{{Unit}}{{else}}{{/if}}',
      trend: calculateTrend(data.{{Name}}),
      change: calculateChange(data.{{Name}})
    },
    {{/each}}
  ]
})

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 生命周期钩子
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

onMounted(async () => {
  // 初始化WebSocket连接
  wsClient.value = new WebSocketClient('{{WebSocketEndpoint}}')
  
  // 连接到WebSocket服务器
  await wsClient.value.connect()

  // 订阅实时数据更新
  wsClient.value.on('{{EntityName}}Updated', (data: {{EntityName}}Dto) => {
    realtimeStore.addData(data)
    updateLastUpdateTime()
  })

  // 启动自动刷新
  if (isAutoRefresh.value) {
    startAutoRefresh()
  }

  // 初始化时间
  updateLastUpdateTime()
})

onUnmounted(() => {
  // 断开WebSocket连接
  if (wsClient.value) {
    wsClient.value.disconnect()
  }
})

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 方法
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * 切换全屏模式
 */
function toggleFullscreen() {
  if (!isFullscreen.value) {
    document.documentElement.requestFullscreen()
    isFullscreen.value = true
  } else {
    document.exitFullscreen()
    isFullscreen.value = false
  }
}

/**
 * 切换自动刷新
 */
function toggleAutoRefresh() {
  isAutoRefresh.value = !isAutoRefresh.value
  
  if (isAutoRefresh.value) {
    startAutoRefresh()
  } else {
    stopAutoRefresh()
  }
}

let refreshTimer: NodeJS.Timeout | null = null

/**
 * 启动自动刷新
 */
function startAutoRefresh() {
  refreshTimer = setInterval(() => {
    // 触发数据刷新（WebSocket会自动推送）
    updateLastUpdateTime()
  }, refreshInterval)
}

/**
 * 停止自动刷新
 */
function stopAutoRefresh() {
  if (refreshTimer) {
    clearInterval(refreshTimer)
    refreshTimer = null
  }
}

/**
 * 更新最后更新时间
 */
function updateLastUpdateTime() {
  const now = new Date()
  lastUpdateTime.value = now.toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit'
  })
}

/**
 * 计算趋势（简单示例：比较当前值与历史平均值）
 */
function calculateTrend(currentValue: number | undefined): 'up' | 'down' | 'flat' {
  if (!currentValue) return 'flat'
  
  const historicalData = realtimeStore.historicalData
  if (historicalData.length < 2) return 'flat'

  const avg = historicalData.reduce((sum, item) => sum + (item as any)[currentValue] ?? 0, 0) / historicalData.length
  
  if (currentValue > avg * 1.05) return 'up'
  if (currentValue < avg * 0.95) return 'down'
  return 'flat'
}

/**
 * 计算变化百分比
 */
function calculateChange(currentValue: number | undefined): number {
  if (!currentValue) return 0

  const historicalData = realtimeStore.historicalData
  if (historicalData.length < 2) return 0

  const previousValue = (historicalData[historicalData.length - 2] as any)[currentValue] ?? 0
  if (previousValue === 0) return 0

  return ((currentValue - previousValue) / previousValue) * 100
}
</script>

