<template>
  <view class="detail-page">
    <view v-if="!loading && detail" class="detail-container">
      {{#each Fields}}
      <view class="detail-item">
        <text class="item-label">{{Label}}</text>
        <text class="item-value">\{{ detail.{{Name}} }}</text>
      </view>
      {{/each}}
    </view>

    <view v-if="loading" class="loading-view">
      <uni-load-more status="loading" />
    </view>

    <view class="action-bar">
      <button class="btn-edit" @click="handleEdit">编辑</button>
      <button class="btn-delete" @click="handleDelete">删除</button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onLoad } from '@dcloudio/uni-app'
import { use{{EntityName}}Store } from '@/stores/{{EntityNameKebab}}-store'
import type { {{EntityName}}Dto } from '@/types/{{EntityNameKebab}}.types'

const {{EntityNameCamel}}Store = use{{EntityName}}Store()
const detail = ref<{{EntityName}}Dto | null>(null)
const loading = ref(false)
const id = ref('')

onLoad((options: any) => {
  if (options.id) {
    id.value = options.id
    loadDetail()
  }
})

async function loadDetail() {
  loading.value = true
  try {
    detail.value = await {{EntityNameCamel}}Store.getById(id.value)
  } catch (error) {
    uni.showToast({ title: '加载失败', icon: 'none' })
  } finally {
    loading.value = false
  }
}

function handleEdit() {
  uni.navigateTo({
    url: `/pages/{{EntityNameKebab}}/form?id=${id.value}`
  })
}

async function handleDelete() {
  uni.showModal({
    title: '确认删除',
    content: '确定要删除吗？',
    async success(res) {
      if (res.confirm) {
        try {
          await {{EntityNameCamel}}Store.delete(id.value)
          uni.showToast({ title: '删除成功', icon: 'success' })
          setTimeout(() => {
            uni.navigateBack()
          }, 1000)
        } catch (error) {
          uni.showToast({ title: '删除失败', icon: 'none' })
        }
      }
    }
  })
}
</script>

