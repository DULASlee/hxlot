import { defineStore } from 'pinia'
import { ref } from 'vue'
import { {{EntityNameCamel}}Api } from '@/api/{{EntityNameKebab}}-api'
import type { {{EntityName}}Dto, Create{{EntityName}}Dto, Update{{EntityName}}Dto, Get{{EntityName}}ListInput } from '@/types/{{EntityNameKebab}}.types'
import type { PagedResultDto } from '@/types/common.types'

export const use{{EntityName}}Store = defineStore('{{EntityNameCamel}}', () => {
  const list = ref<{{EntityName}}Dto[]>([])
  const total = ref(0)
  const loading = ref(false)

  async function getList(params: Get{{EntityName}}ListInput): Promise<PagedResultDto<{{EntityName}}Dto>> {
    loading.value = true
    try {
      const result = await {{EntityNameCamel}}Api.getList(params)
      
      // 离线缓存
      uni.setStorageSync('{{EntityNameCamel}}_list', result.items)
      uni.setStorageSync('{{EntityNameCamel}}_list_time', Date.now())
      
      list.value = result.items
      total.value = result.totalCount
      
      return result
    } catch (error) {
      // 离线模式：从缓存读取
      const cachedList = uni.getStorageSync('{{EntityNameCamel}}_list') || []
      const cachedTime = uni.getStorageSync('{{EntityNameCamel}}_list_time') || 0
      
      if (cachedList.length > 0 && (Date.now() - cachedTime < 3600000)) {
        list.value = cachedList
        total.value = cachedList.length
        return { items: cachedList, totalCount: cachedList.length }
      }
      
      throw error
    } finally {
      loading.value = false
    }
  }

  async function getById(id: string): Promise<{{EntityName}}Dto> {
    try {
      return await {{EntityNameCamel}}Api.getById(id)
    } catch (error) {
      // 离线模式：从缓存列表中查找
      const cachedList = uni.getStorageSync('{{EntityNameCamel}}_list') || []
      const item = cachedList.find((x: {{EntityName}}Dto) => x.id === id)
      if (item) return item
      throw error
    }
  }

  async function create(data: Create{{EntityName}}Dto): Promise<{{EntityName}}Dto> {
    loading.value = true
    try {
      const result = await {{EntityNameCamel}}Api.create(data)
      list.value.unshift(result)
      total.value++
      return result
    } finally {
      loading.value = false
    }
  }

  async function update(id: string, data: Update{{EntityName}}Dto): Promise<{{EntityName}}Dto> {
    loading.value = true
    try {
      const result = await {{EntityNameCamel}}Api.update(id, data)
      const index = list.value.findIndex(x => x.id === id)
      if (index > -1) {
        list.value[index] = result
      }
      return result
    } finally {
      loading.value = false
    }
  }

  async function deleteItem(id: string): Promise<void> {
    loading.value = true
    try {
      await {{EntityNameCamel}}Api.delete(id)
      const index = list.value.findIndex(x => x.id === id)
      if (index > -1) {
        list.value.splice(index, 1)
        total.value--
      }
    } finally {
      loading.value = false
    }
  }

  return {
    list,
    total,
    loading,
    getList,
    getById,
    create,
    update,
    delete: deleteItem
  }
})

