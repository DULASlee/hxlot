/**
 * 分页结果DTO
 */
export interface PagedResultDto<T> {
  /**
   * 数据项
   */
  items: T[]

  /**
   * 总数量
   */
  totalCount: number
}

/**
 * 列表结果DTO
 */
export interface ListResultDto<T> {
  /**
   * 数据项
   */
  items: T[]
}

