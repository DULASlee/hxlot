// UniApp离线数据同步类型
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * 离线数据项
 */
export interface OfflineData<T> {
  /**
   * 本地ID（临时ID）
   */
  localId: string

  /**
   * 服务器ID（同步后更新）
   */
  serverId?: string

  /**
   * 数据内容
   */
  data: T

  /**
   * 同步状态
   */
  syncStatus: SyncStatus

  /**
   * 操作类型
   */
  operation: 'create' | 'update' | 'delete'

  /**
   * 创建时间
   */
  createdAt: number

  /**
   * 最后修改时间
   */
  updatedAt: number

  /**
   * 尝试次数
   */
  retryCount: number

  /**
   * 错误信息
   */
  error?: string
}

/**
 * 同步状态
 */
export enum SyncStatus {
  /**
   * 待同步
   */
  Pending = 'pending',

  /**
   * 同步中
   */
  Syncing = 'syncing',

  /**
   * 已同步
   */
  Synced = 'synced',

  /**
   * 同步失败
   */
  Failed = 'failed',

  /**
   * 冲突
   */
  Conflict = 'conflict'
}

/**
 * 冲突解决策略
 */
export enum ConflictResolution {
  /**
   * 使用本地数据
   */
  UseLocal = 'use_local',

  /**
   * 使用服务器数据
   */
  UseServer = 'use_server',

  /**
   * 手动解决
   */
  Manual = 'manual'
}

/**
 * 同步结果
 */
export interface SyncResult {
  /**
   * 成功数量
   */
  successCount: number

  /**
   * 失败数量
   */
  failedCount: number

  /**
   * 冲突数量
   */
  conflictCount: number

  /**
   * 失败详情
   */
  failures: Array<{
    localId: string
    error: string
  }>

  /**
   * 冲突详情
   */
  conflicts: Array<{
    localId: string
    localData: any
    serverData: any
  }>
}

