// 通用类型
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

/**
 * API响应结果
 */
export interface ApiResponse<T = any> {
  /**
   * 成功标志
   */
  success: boolean

  /**
   * 响应数据
   */
  result?: T

  /**
   * 错误信息
   */
  error?: {
    code: string
    message: string
    details?: string
  }
}

/**
 * 加载状态
 */
export type LoadingStatus = 'idle' | 'loading' | 'success' | 'error'

/**
 * 加载更多状态
 */
export type LoadMoreStatus = 'more' | 'loading' | 'noMore'

