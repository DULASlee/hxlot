// utils/upload.ts
/**
 * 文件上传工具（支持分片上传）
 * @author SmartAbp DevKit Low-Code Engine
 * @since {{GeneratedTime}}
 */

import { useAuthStore } from '@/composables/useAuth'

const CHUNK_SIZE = 1024 * 1024 // 1MB per chunk

/**
 * 普通文件上传
 */
export function uploadFile(
  filePath: string,
  onProgress?: (progress: number) => void
): Promise<string> {
  const authStore = useAuthStore()
  
  return new Promise((resolve, reject) => {
    const uploadTask = uni.uploadFile({
      url: `${getBaseUrl()}/api/file/upload`,
      filePath,
      name: 'file',
      header: {
        'Authorization': `Bearer ${authStore.accessToken}`
      },
      success: (res) => {
        if (res.statusCode === 200) {
          const data = JSON.parse(res.data)
          resolve(data.url)
        } else {
          reject(new Error(`Upload failed: ${res.statusCode}`))
        }
      },
      fail: reject
    })

    if (onProgress) {
      uploadTask.onProgressUpdate((res) => {
        onProgress(res.progress)
      })
    }
  })
}

/**
 * 大文件分片上传
 */
export async function uploadLargeFile(
  filePath: string,
  onProgress?: (progress: number) => void
): Promise<string> {
  const authStore = useAuthStore()
  
  // 获取文件信息
  const fileInfo = await uni.getFileInfo({ filePath })
  const totalSize = fileInfo.size
  const totalChunks = Math.ceil(totalSize / CHUNK_SIZE)
  
  // 初始化上传
  const uploadId = `upload_${Date.now()}_${Math.random()}`
  
  // 分片上传
  for (let i = 0; i < totalChunks; i++) {
    const start = i * CHUNK_SIZE
    const end = Math.min(start + CHUNK_SIZE, totalSize)
    
    // 上传分片
    await uni.uploadFile({
      url: `${getBaseUrl()}/api/file/upload-chunk`,
      filePath,
      name: 'file',
      formData: {
        uploadId,
        chunkIndex: i,
        totalChunks
      },
      header: {
        'Authorization': `Bearer ${authStore.accessToken}`
      }
    })
    
    // 更新进度
    if (onProgress) {
      onProgress(((i + 1) / totalChunks) * 100)
    }
  }
  
  // 合并分片
  const response = await uni.request({
    url: `${getBaseUrl()}/api/file/merge-chunks`,
    method: 'POST',
    data: { uploadId, totalChunks },
    header: {
      'Authorization': `Bearer ${authStore.accessToken}`
    }
  })
  
  if (response.statusCode === 200 && response.data) {
    return (response.data as any).url
  }
  
  throw new Error('Merge chunks failed')
}

function getBaseUrl(): string {
  // #ifdef H5
  return '/api'
  // #endif
  
  // #ifdef APP-PLUS || MP
  return 'https://your-api-domain.com'
  // #endif
}

