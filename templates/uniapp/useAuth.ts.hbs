/**
 * JWT认证Composable
 * @author SmartAbp DevKit Low-Code Engine
 * @since {{GeneratedTime}}
 * @description 提供完整的JWT认证功能：登录、登出、Token刷新、Token存储
 */

import { ref, computed } from 'vue'
import { defineStore } from 'pinia'
import { storage } from '@/utils/storage'

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 认证相关类型定义
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

export interface LoginRequest {
  userNameOrEmailAddress: string
  password: string
  rememberMe?: boolean
}

export interface LoginResponse {
  accessToken: string
  refreshToken?: string
  expiration: number
  userId: string
  userName: string
}

export interface UserInfo {
  id: string
  userName: string
  email?: string
  phoneNumber?: string
  roles?: string[]
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 认证Store
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

export const useAuthStore = defineStore('auth', () => {
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // State
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  
  const accessToken = ref<string | null>(null)
  const refreshToken = ref<string | null>(null)
  const tokenExpiration = ref<number | null>(null)
  const userInfo = ref<UserInfo | null>(null)
  const loading = ref(false)

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // Computed
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  
  const isAuthenticated = computed(() => {
    return !!accessToken.value && !isTokenExpired()
  })

  const isTokenExpired = () => {
    if (!tokenExpiration.value) return true
    return Date.now() >= tokenExpiration.value
  }

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // Actions
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  /**
   * 登录
   */
  async function login(credentials: LoginRequest): Promise<boolean> {
    loading.value = true
    try {
      const response = await uni.request({
        url: `${getBaseUrl()}/api/account/login`,
        method: 'POST',
        data: credentials
      })

      if (response.statusCode === 200 && response.data) {
        const loginData = response.data as LoginResponse
        
        // 存储Token
        accessToken.value = loginData.accessToken
        refreshToken.value = loginData.refreshToken || null
        tokenExpiration.value = loginData.expiration
        
        // 存储用户信息
        userInfo.value = {
          id: loginData.userId,
          userName: loginData.userName
        }

        // 持久化到本地存储
        await saveToStorage()
        
        // 获取完整用户信息
        await fetchUserInfo()

        return true
      }

      return false
    } catch (error) {
      console.error('Login failed:', error)
      uni.showToast({
        title: '登录失败',
        icon: 'none'
      })
      return false
    } finally {
      loading.value = false
    }
  }

  /**
   * 登出
   */
  async function logout() {
    try {
      // 调用服务端登出接口（可选）
      if (accessToken.value) {
        await uni.request({
          url: `${getBaseUrl()}/api/account/logout`,
          method: 'POST',
          header: {
            'Authorization': `Bearer ${accessToken.value}`
          }
        }).catch(() => {
          // 忽略登出接口错误
        })
      }
    } finally {
      // 清除本地状态
      accessToken.value = null
      refreshToken.value = null
      tokenExpiration.value = null
      userInfo.value = null
      
      // 清除本地存储
      await clearStorage()
      
      // 跳转到登录页
      uni.reLaunch({
        url: '/pages/login/login'
      })
    }
  }

  /**
   * 刷新Token
   */
  async function refreshAccessToken(): Promise<boolean> {
    if (!refreshToken.value) {
      return false
    }

    try {
      const response = await uni.request({
        url: `${getBaseUrl()}/api/account/refresh-token`,
        method: 'POST',
        data: {
          refreshToken: refreshToken.value
        }
      })

      if (response.statusCode === 200 && response.data) {
        const loginData = response.data as LoginResponse
        
        accessToken.value = loginData.accessToken
        tokenExpiration.value = loginData.expiration
        
        if (loginData.refreshToken) {
          refreshToken.value = loginData.refreshToken
        }

        await saveToStorage()
        
        return true
      }

      return false
    } catch (error) {
      console.error('Token refresh failed:', error)
      return false
    }
  }

  /**
   * 获取用户信息
   */
  async function fetchUserInfo() {
    if (!accessToken.value) return

    try {
      const response = await uni.request({
        url: `${getBaseUrl()}/api/account/my-profile`,
        method: 'GET',
        header: {
          'Authorization': `Bearer ${accessToken.value}`
        }
      })

      if (response.statusCode === 200 && response.data) {
        userInfo.value = response.data as UserInfo
        await saveToStorage()
      }
    } catch (error) {
      console.error('Fetch user info failed:', error)
    }
  }

  /**
   * 从本地存储恢复认证状态
   */
  async function restoreAuth() {
    try {
      const storedAccessToken = await storage.get('accessToken')
      const storedRefreshToken = await storage.get('refreshToken')
      const storedExpiration = await storage.get('tokenExpiration')
      const storedUserInfo = await storage.get('userInfo')

      if (storedAccessToken) {
        accessToken.value = storedAccessToken
        refreshToken.value = storedRefreshToken
        tokenExpiration.value = storedExpiration ? parseInt(storedExpiration) : null
        userInfo.value = storedUserInfo ? JSON.parse(storedUserInfo) : null

        // 检查Token是否过期
        if (isTokenExpired()) {
          // 尝试刷新Token
          const refreshed = await refreshAccessToken()
          if (!refreshed) {
            await logout()
          }
        }
      }
    } catch (error) {
      console.error('Restore auth failed:', error)
    }
  }

  /**
   * 保存到本地存储
   */
  async function saveToStorage() {
    try {
      await storage.set('accessToken', accessToken.value || '')
      await storage.set('refreshToken', refreshToken.value || '')
      await storage.set('tokenExpiration', tokenExpiration.value?.toString() || '')
      await storage.set('userInfo', userInfo.value ? JSON.stringify(userInfo.value) : '')
    } catch (error) {
      console.error('Save to storage failed:', error)
    }
  }

  /**
   * 清除本地存储
   */
  async function clearStorage() {
    try {
      await storage.remove('accessToken')
      await storage.remove('refreshToken')
      await storage.remove('tokenExpiration')
      await storage.remove('userInfo')
    } catch (error) {
      console.error('Clear storage failed:', error)
    }
  }

  /**
   * 获取API基础URL
   */
  function getBaseUrl(): string {
    // TODO: 从配置文件或环境变量读取
    // #ifdef H5
    return '/api' // H5使用相对路径，通过Nginx代理
    // #endif
    
    // #ifdef APP-PLUS || MP
    return 'https://your-api-domain.com' // 原生App和小程序使用完整URL
    // #endif
  }

  return {
    // State
    accessToken,
    refreshToken,
    tokenExpiration,
    userInfo,
    loading,
    // Computed
    isAuthenticated,
    // Actions
    login,
    logout,
    refreshAccessToken,
    fetchUserInfo,
    restoreAuth,
    saveToStorage,
    clearStorage
  }
})

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Composable导出
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

export function useAuth() {
  const authStore = useAuthStore()
  
  return {
    // State
    accessToken: authStore.accessToken,
    userInfo: authStore.userInfo,
    loading: authStore.loading,
    // Computed
    isAuthenticated: authStore.isAuthenticated,
    // Actions
    login: authStore.login,
    logout: authStore.logout,
    refreshToken: authStore.refreshAccessToken,
    restoreAuth: authStore.restoreAuth
  }
}

