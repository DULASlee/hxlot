/**
 * 文件上传Composable
 * @author SmartAbp DevKit Low-Code Engine
 * @since {{GeneratedTime}}
 */

import { ref } from 'vue'
import { uploadFile, uploadLargeFile } from '@/utils/upload'

export function useFileUpload() {
  const uploading = ref(false)
  const progress = ref(0)

  /**
   * 选择并上传图片
   */
  async function uploadImage(count: number = 1) {
    try {
      const res = await uni.chooseImage({
        count,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera']
      })

      uploading.value = true
      const uploadedUrls: string[] = []

      for (const filePath of res.tempFilePaths) {
        const url = await uploadFile(filePath, (p) => {
          progress.value = p
        })
        uploadedUrls.push(url)
      }

      return uploadedUrls
    } finally {
      uploading.value = false
      progress.value = 0
    }
  }

  /**
   * 上传大文件（分片上传）
   */
  async function uploadLarge(filePath: string) {
    uploading.value = true
    try {
      return await uploadLargeFile(filePath, (p) => {
        progress.value = p
      })
    } finally {
      uploading.value = false
      progress.value = 0
    }
  }

  return {
    uploading,
    progress,
    uploadImage,
    uploadLarge
  }
}

