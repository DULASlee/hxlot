/**
 * 离线数据同步Composable
 * @author SmartAbp DevKit Low-Code Engine
 * @since {{GeneratedTime}}
 */

import { ref } from 'vue'
import { storage } from '@/utils/storage'

export interface OfflineData<T = any> {
  id: string
  type: 'create' | 'update' | 'delete'
  data: T
  timestamp: number
  synced: boolean
}

export function useOfflineSync<T = any>(storageKey: string) {
  const isSyncing = ref(false)
  const pendingCount = ref(0)

  /**
   * 保存离线数据
   */
  async function saveOffline(type: 'create' | 'update' | 'delete', data: T) {
    const offlineData: OfflineData<T> = {
      id: `offline_${Date.now()}_${Math.random()}`,
      type,
      data,
      timestamp: Date.now(),
      synced: false
    }

    const existing = await getOfflineData()
    existing.push(offlineData)
    await storage.set(storageKey, JSON.stringify(existing))
    
    pendingCount.value = existing.length
  }

  /**
   * 获取离线数据
   */
  async function getOfflineData(): Promise<OfflineData<T>[]> {
    const data = await storage.get(storageKey)
    return data ? JSON.parse(data) : []
  }

  /**
   * 同步离线数据到服务器
   */
  async function syncToServer(syncFn: (item: OfflineData<T>) => Promise<void>) {
    isSyncing.value = true
    try {
      const offlineData = await getOfflineData()
      const unsynced = offlineData.filter(item => !item.synced)

      for (const item of unsynced) {
        try {
          await syncFn(item)
          item.synced = true
        } catch (error) {
          console.error('Sync item failed:', item, error)
        }
      }

      // 保存同步状态
      await storage.set(storageKey, JSON.stringify(offlineData))
      
      // 清除已同步数据
      const remaining = offlineData.filter(item => !item.synced)
      await storage.set(storageKey, JSON.stringify(remaining))
      
      pendingCount.value = remaining.length
    } finally {
      isSyncing.value = false
    }
  }

  /**
   * 清除所有离线数据
   */
  async function clearOfflineData() {
    await storage.remove(storageKey)
    pendingCount.value = 0
  }

  return {
    isSyncing,
    pendingCount,
    saveOffline,
    getOfflineData,
    syncToServer,
    clearOfflineData
  }
}

