#!/bin/bash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🛡️ AI编程铁律执行引擎 - Git Pre-commit Hook
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 
# 功能：
# - 在每次提交前自动检查代码行数
# - 强制执行300行限制
# - 防止违规代码提交到仓库
# 
# 安装：
# cp tools/ai-guardian/pre-commit.template .git/hooks/pre-commit
# chmod +x .git/hooks/pre-commit
# 
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

echo ""
echo "🛡️ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🛡️ AI代码行数追踪检查"
echo "🛡️ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 执行代码行数检查
node tools/ai-guardian/CodeLineTracker.js check

# 检查返回状态
if [ $? -ne 0 ]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "❌ Git提交被阻止！"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "原因：代码行数超出300行限制"
  echo ""
  echo "💡 建议操作："
  echo "   1. 执行质量门禁检查："
  echo "      cd src/SmartAbp.Vue && npm run type-check"
  echo "      cd src/SmartAbp.Vue && npm run lint"
  echo ""
  echo "   2. 生成代码追踪报告："
  echo "      node tools/ai-guardian/CodeLineTracker.js report"
  echo ""
  echo "   3. 如果质量检查通过，重置计数器："
  echo "      node tools/ai-guardian/CodeLineTracker.js reset"
  echo ""
  echo "   4. 重新提交："
  echo "      git commit"
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 1
fi

echo ""
echo "✅ 代码行数检查通过，继续提交..."
echo ""

exit 0

